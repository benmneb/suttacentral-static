---
layout: base.liquid
styles:
  - site-pages.css
eleventyComputed:
  og_tags: '{{ sitePagesData.pageMetadata[page.url].scx_og_tags }}'
  json_ld: '{{ sitePagesData.pageMetadata[page.url].scx_json_ld }}'
---
<a class="skip" href="#main">Skip to main content</a>
<header>
  {% if crumbs or parentCrumb %}
    {% capture breadcrumbsList %}
      {% if crumbs %}
        {% for crumb in crumbs %}
          <li>
            <a href="{{ crumb.href }}">{{ crumb.name }}</a>
          </li>
        {% endfor %}
      {% endif %}
      {% if parentCrumb %}
        <li>
          <a href="{{ parentHref }}">{{ parentCrumb }}</a>
        </li>
      {% endif %}
      <li>
        <span aria-current="page">{{ crumb | default: title }}</span>
      </li>
    {% endcapture %}
    {% include "headerNav.liquid", breadcrumbsList: breadcrumbsList %}
  {% else %}
    {% include "headerNav.liquid" %}
  {% endif %}
</header>

<main id="main" class="site-page{% if mainClass %} {{ mainClass }}{% endif %}">
  {{ content }}
</main>

{% assign route = page.url
  | remove_first: "/"
  | remove_last: "/"
  | replace: " ", "%20"
%}
{% assign fetchedAt = sitePagesData.fetchedAt[fetchedFrom]
  | default: sitePagesData.fetchedAt.strings
%}
{% include "footer.liquid", route: route, fetchedAt: fetchedAt %}
