<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% assign isNotFound = false %}
    {% if page.url == "/404.html" %}
      {% assign isNotFound = true %}
    {% endif %}
    {% assign ogJson = og_tags %}
    {% unless ogJson or isNotFound %}
      {% assign ogJson = title
        | default: _siteMetaData.title
        | ogTags: page.url
      %}
    {% endunless %}
    {% if ogJson %}
      {% assign parsedTags = ogJson | parseJSON %}
    {% endif %}
    <meta
      name="description"
      content="{{ parsedTags['og:description'] | default: _siteMetaData.description | escape }}"
    >
    {% assign pageTitle = _siteMetaData.title %}
    {% if title %}
      {% assign pageTitle = title | append: " @ " | append: pageTitle %}
    {% endif %}
    <title>{{ pageTitle }}</title>
    {% unless isNotFound %}
      <link rel="canonical" href="{{ _siteMetaData.origin }}{{ page.url | url | route | uri_escape }}">
    {% endunless %}
    {% for tag in parsedTags %}
      {% if tag[1] %}
        <meta property="{{ tag[0] }}" content="{{ tag[1] | escape }}">
      {% endif %}
    {% endfor %}
    <meta name="twitter:card" content="summary_large_image">
    <link rel="stylesheet" href="/styles/styles.css">
    {% for sheet in styles %}
      <link rel="stylesheet" href="/styles/{{ sheet }}">
    {% endfor %}
    {% if headStyle %}
      <style>
        {{ headStyle }}
      </style>
    {% endif %}
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="64x64" href="/images/favicon-64x64.png">
    <link rel="icon" type="image/png" sizes="250x250" href="/images/favicon-250x250.png">
    <link rel="apple-touch-icon" sizes="250x250" href="/images/favicon-250x250.png">
    {% if json_ld %}
      <script type="application/ld+json">
        {{ json_ld }}
      </script>
    {% endif %}
    <script
      defer
      data-allow-params="query"
      src="https://scripts.simpleanalyticscdn.com/light.js"
    ></script>
    <script src="/scripts/preSearch.js" defer></script>
    {% if scripts %}
      {% for script in scripts %}
        <script src="/scripts/{{ script }}" defer></script>
      {% endfor %}
    {% endif %}
  </head>
  <body>
    {{ content }}
    <noscript>
      <img
        src="https://queue.simpleanalyticscdn.com/noscript.gif"
        alt=""
        referrerpolicy="no-referrer-when-downgrade"
      >
    </noscript>
  </body>
</html>
