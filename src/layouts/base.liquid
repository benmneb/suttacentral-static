<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% assign isNotFound = false %}
    {% if page.url == "/404.html" %}
      {% assign isNotFound = true %}
    {% endif %}
    {% assign ogJson = og_tags %}
    {% unless ogJson or isNotFound %}
      {% assign ogJson = title
        | default: _siteMetaData.title
        | ogTags: page.url
      %}
    {% endunless %}
    {% if ogJson %}
      {% assign parsedTags = ogJson | parseJSON %}
    {% endif %}
    <meta
      name="description"
      content="{{ parsedTags['og:description'] | default: _siteMetaData.description | escape }}"
    >
    {% assign pageTitle = _siteMetaData.title %}
    {% if title %}
      {% assign pageTitle = title | append: " @ " | append: pageTitle %}
    {% endif %}
    <title>{{ pageTitle }}</title>
    {% unless isNotFound %}
      <link rel="canonical" href="{{ _siteMetaData.origin }}{{ page.url | url | route | uri_escape }}">
    {% endunless %}
    {% for tag in parsedTags %}
      {% if tag[1] %}
        <meta property="{{ tag[0] }}" content="{{ tag[1] | escape }}">
      {% endif %}
    {% endfor %}
    <meta name="twitter:card" content="summary_large_image">
    <link rel="stylesheet" href="{{ 'styles.css' | asset }}">
    {% for sheet in styles %}
      <link rel="stylesheet" href="{{ sheet | asset }}">
    {% endfor %}
    <link rel="stylesheet" href="{{ 'print.css' | asset }}" media="print">
    {% if headStyle %}
      <style>
        {{ headStyle }}
      </style>
    {% endif %}
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="64x64" href="/images/favicon-64x64.png">
    <link rel="icon" type="image/png" sizes="250x250" href="/images/favicon-250x250.png">
    <link rel="apple-touch-icon" sizes="250x250" href="/images/favicon-250x250.png">
    {% if json_ld %}
      <script type="application/ld+json">
        {{ json_ld }}
      </script>
    {% endif %}
    <script src="{{ 'preSearch.js' | asset }}" defer></script>
    {% if scripts %}
      {% for script in scripts %}
        <script src="{{ script | asset }}" defer></script>
      {% endfor %}
    {% endif %}
    {% if _siteMetaData.analytics.src %}
      <script
        src="{{ _siteMetaData.analytics.src }}"
        {% for attribute in _siteMetaData.analytics.attributes %}
          {%- if attribute[1] == true %}
            {{ attribute[0] -}}
          {%- elsif attribute[1] != false %}
            {{ attribute[0] }}="{{ attribute[1] }}"
          {%- endif -%}
        {% endfor %}
      ></script>
    {% endif %}
  </head>
  <body>
    {{ content }}
  </body>
</html>
