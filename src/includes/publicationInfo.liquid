{% assign pub = entry._publication_info %}
{% assign pub_edition = pub.edition[0] %}
{% assign pub_license = pub.license %}
<h1>Publication Info</h1>

<div about="{{ pub.source_url }}">
  {% if pub.translation_title != blank
    or pub.translation_subtitle != blank
    or pub.author_name != blank
    or pub.collaborator != blank
  %}
    <section>
      <h2 class="sr-only">Basic Translation Details</h2>
      <dl>
        {% if pub.translation_title != blank %}
          <dt>Translation title</dt>
          <dd property="dc:title">{{ pub.translation_title }}</dd>
        {% endif %}
        {% if pub.translation_subtitle != blank %}
          <dt>Translation subtitle</dt>
          <dd property="dc:title">{{ pub.translation_subtitle }}</dd>
        {% endif %}
        {% if pub.author_name != blank %}
          <dt>Translator</dt>
          <dd property="dc:creator">{{ pub.author_name }}</dd>
        {% endif %}
        {% if pub.collaborator != blank %}
          <dt>Collaborator</dt>
          <dd property="dc:creator">{{ pub.collaborator }}</dd>
        {% endif %}
      </dl>
    </section>
  {% endif %}

  {% if pub.root_title != blank
    or pub.translation_lang_name != blank
    or pub.root_lang_name != blank
  %}
    <section>
      <h2 class="sr-only">Language Information</h2>
      <dl>
        {% if pub.root_title != blank %}
          <dt>Root title</dt>
          <dd property="dc:title">{{ pub.root_title }}</dd>
        {% endif %}
        {% if pub.translation_lang_name != blank %}
          <dt>Translation language</dt>
          <dd property="dc:language">
            {{ pub.translation_lang_name | languageName }}
          </dd>
        {% endif %}
        {% if pub.root_lang_name != blank %}
          <dt>Root language</dt>
          <dd>{{ pub.root_lang_name | languageName }}</dd>
        {% endif %}
      </dl>
    </section>
  {% endif %}

  {% if pub.translation_description != blank
    or pub.translation_process != blank
    or pub.publication_status != blank
  %}
    <section>
      <h2 class="sr-only">Description and Process Information</h2>
      <dl>
        {% if pub.translation_description != blank %}
          <dt>Translations description</dt>
          <dd property="dc:description">{{ pub.translation_description }}</dd>
        {% endif %}
        {% if pub.translation_process != blank %}
          <dt>Translations process</dt>
          <dd property="dc:description">{{ pub.translation_process }}</dd>
        {% endif %}
        {% if pub.publication_status != blank %}
          <dt>Publication status</dt>
          <dd>{{ pub.publication_status }}</dd>
        {% endif %}
      </dl>
    </section>
  {% endif %}

  {% if pub_edition.edition_number != blank
    or pub_edition.publication_date != blank
    or pub_edition.publisher != blank
    or pub_edition.publication_type != blank
  %}
    <section>
      <h2 class="sr-only">Publication Details</h2>
      <dl>
        {% if pub_edition.edition_number != blank %}
          <dt>Edition</dt>
          <dd>{{ pub_edition.edition_number }}</dd>
        {% endif %}
        {% if pub_edition.publication_date != blank %}
          <dt>Publication date</dt>
          <dd property="dc:date">
            <time datetime="{{ pub_edition.publication_date }}">
              {{- pub_edition.publication_date -}}
            </time>
          </dd>
        {% endif %}
        {% if pub_edition.publisher != blank %}
          <dt>Publisher</dt>
          <dd property="dc:publisher">{{ pub_edition.publisher }}</dd>
        {% endif %}
        {% if pub_edition.publication_type != blank %}
          <dt>Publication type</dt>
          <dd property="dc:format">{{ pub_edition.publication_type }}</dd>
        {% endif %}
      </dl>
    </section>
  {% endif %}

  {% if pub_edition.edition_url != blank
    or pub.source_url != blank
    or pub._key != blank
  %}
    <section>
      <h2 class="sr-only">Links and Identifiers</h2>
      <dl>
        {% if pub_edition.edition_url != blank %}
          <dt>URL</dt>
          <dd>
            <a href="{{ pub_edition.edition_url }}">
              {{- pub_edition.edition_url -}}
            </a>
          </dd>
        {% endif %}
        {% if pub.source_url != blank %}
          <dt>Source</dt>
          <dd>
            <a href="{{ pub.source_url }}">{{ pub.source_url }}</a>
          </dd>
        {% endif %}
        {% if pub._key != blank %}
          <dt>SuttaCentral publication number</dt>
          <dd property="dc:identifier">{{ pub._key }}</dd>
        {% endif %}
      </dl>
    </section>
  {% endif %}
</div>

{% if pub_license.license_type != blank
  or pub_license.license_url != blank
  or pub_license.license_statement != blank
%}
  <section>
    <h2>License</h2>
    {% if pub_license.license_type != blank %}
      <p property="dc:rights">{{ pub_license.license_type }}</p>
    {% endif %}
    {% if pub_license.license_url != blank %}
      <p>
        <a href="{{ pub_license.license_url }}">
          {{- pub_license.license_url -}}
        </a>
      </p>
    {% endif %}
    {% if pub_license.license_statement != blank %}
      <p>{{ pub_license.license_statement }}</p>
    {% endif %}
  </section>
{% endif %}
