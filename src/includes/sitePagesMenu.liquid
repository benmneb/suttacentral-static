{% assign current = "/" | append: route %}
<nav id="site-pages" popover aria-label="Site pages">
  {% for group in sitePagesData.siteMap %}
    <section>
      <h2>{{ group.heading }}</h2>
      <ul>
        {% for link in group.pages %}
          {% assign pageIcon = sitePagesData.pageIcons[link.href] %}
          <li>
            <i class="icon i-{{ pageIcon }}"></i>
            {% if link.href == current %}
              <span aria-current="page">{{ link.label }}</span>
            {% else %}
              <a
                href="{{ link.href }}"
                {% if link.href contains "://" %}
                  rel="external"
                {% endif %}
              >
                {{- link.label -}}
              </a>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endfor %}
</nav>
