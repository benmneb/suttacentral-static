<nav aria-label="Breadcrumb">
  <ul>
    {% if isHome %}
      <li aria-current="page">
        <span>
          {%- icon "home" -%}
          <span class="sr-only">Home</span></span
        >
      </li>
    {% else %}
      <li>
        <a href="/" aria-label="Home">
          {%- icon "home" -%}
          <span class="sr-only">Home</span></a
        >
      </li>
      {{ breadcrumbsList }}
    {% endif %}
  </ul>
  <div>
    {% unless excludeSearch %}
      <button
        class="icon-button"
        type="button"
        commandfor="search-modal"
        command="show-modal"
        aria-label="Search"
        title="Cmd/Ctrl+K"
      >
        {% icon "magnifyingGlass" %}
      </button>
    {% endunless %}
    <button
      class="icon-button"
      type="button"
      popovertarget="site-pages"
      aria-label="Site pages"
      title="Site pages"
    >
      {% icon "bars3" %}
    </button>
  </div>
</nav>
{% unless excludeSearch %}
  <dialog id="search-modal" aria-label="Search" closedby="any">
    {% include "searchForm.liquid" %}
  </dialog>
{% endunless %}
