<details
  {% if parallelsOpen %}
    open
  {% endif %}
>
  <summary>
    Parallels (
    {{-
      entry.scx_range_sutta_parallels_count
      | default: entry.parallel_count
    -}}
    )
  </summary>
  <ul>
    {% assign parallels = entry.scx_range_sutta_parallels_data
      | default: entry._parallels_data
    %}
    {% for segment in parallels %}
      {% unless segment[0] contains "scx_fetched_at" %}
        <li>
          {% assign root_trans = entry.translations
            | default: entry._suttas_data.suttaplex.translations
            | where: "is_root", true
            | first
          %}
          {% assign base_path = segment[0] | parallelPath: entry %}
          {% comment %} No link without a root text, ie the Pātimokkha's rules, as on .net {% endcomment %}
          {% if root_trans %}
            <a href="/{{ base_path }}/{{ root_trans.lang }}/{{ root_trans.author_uid | default: "null" }}{{ segment[0] | parallelAnchor }}">
              {{- segment[0] | parallelLabel: entry -}}
            </a>
          {% else %}
            <span>{{ segment[0] | parallelLabel: entry }}</span>
          {% endif %}
          <ul>
            {{ segment[1] | parallelItemsHtml: true }}
          </ul>
        </li>
      {% endunless %}
    {% endfor %}
  </ul>
</details>
