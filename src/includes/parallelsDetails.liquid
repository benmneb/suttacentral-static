<details
  {% if parallelsOpen %}
    open
  {% endif %}
>
  <summary>
    Parallels (
    {{-
      entry.scx_range_sutta_parallels_count
      | default: entry.parallel_count
    -}}
    )
  </summary>
  <ul>
    {% assign parallels = entry.scx_range_sutta_parallels_data
      | default: entry._parallels_data
    %}
    {% for segment in parallels %}
      {% unless segment[0] contains "scx_fetched_at" %}
        <li>
          {% assign root_trans = entry.translations
            | default: entry._suttas_data.suttaplex.translations
            | where: "is_root", true
            | first
          %}
          {% assign base_path = segment[0] | parallelPath: entry.uid %}
          <a href="/{{ base_path }}/{{ root_trans.lang }}/{{ root_trans.author_uid }}{% if segment[0] contains '#' %}#{{ segment[0] | split: '#' | last }}{% endif %}">
            {{- segment[0] -}}
          </a>
          <ul>
            {% include "parallelItems.liquid",
              parallels: segment[1],
              typed: true
            %}
          </ul>
        </li>
      {% endunless %}
    {% endfor %}
  </ul>
</details>
