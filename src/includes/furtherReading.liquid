{% assign readingGuides = sitePagesData.pitakaGuides[uid] %}
{% assign readingEdition = sitePagesData.editionLinks[uid] %}
{% if readingGuides or readingEdition %}
  <ul class="further-reading" aria-label="Further reading">
    {% for guide in readingGuides %}
      <li>
        <a href="{{ guide.href }}"
          ><i class="icon i-{{ sitePagesData.pageIcons[guide.href] }}"></i
          ><cite>{{ guide.title }}</cite></a
        >
        <span>{{ guide.byline }}</span>
      </li>
    {% endfor %}
    {% if readingEdition %}
      <li>
        <a href="{{ readingEdition.href }}">
          {%- icon "bookOpen" -%}
          <cite>{{ readingEdition.title }}</cite></a
        >
        <span>{{ readingEdition.creator }}</span>
        <span class="tagline">
          A SuttaCentral Edition available in print and multiple digital formats
          for offline reading
        </span>
      </li>
    {% endif %}
  </ul>
{% endif %}
