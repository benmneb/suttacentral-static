{% include "sitePagesMenu.liquid" %}
<footer>
  {% if _siteMetaData.description %}
    <p>{{ _siteMetaData.description }}</p>
  {% endif %}
  <p>
    View this page on
    <a id="sc-redirect" href="{{ scOrigin }}/{{ route }}" rel="external"
      >SuttaCentral.net</a
    >
  </p>
  {% if fetchedAt %}
    <p id="updated">
      This page was last updated from SuttaCentral.net on<br>
      {{ fetchedAt | split: ", " | last }}
    </p>
  {% endif %}
  {% unless _siteMetaData.source == blank
    and _siteMetaData.analytics.shareUrl == blank
    and _siteMetaData.accessibility == blank
    and _siteMetaData.archive == blank
    and _siteMetaData.feedback == blank
  %}
    <ul>
      {% if _siteMetaData.source %}
        <li>
          <a href="{{ _siteMetaData.source }}" rel="external">Open source</a>
        </li>
      {% endif %}
      {% if _siteMetaData.analytics.shareUrl %}
        <li>
          <a href="{{ _siteMetaData.analytics.shareUrl }}" rel="external"
            >Open analytics</a
          >
        </li>
      {% endif %}
      {% if _siteMetaData.accessibility %}
        <li>
          <a href="{{ _siteMetaData.accessibility }}" rel="external"
            >Accessibility</a
          >
        </li>
      {% endif %}
      {% if _siteMetaData.archive %}
        <li>
          <a href="/offline#scx-offline">Use offline</a>
        </li>
      {% endif %}
      {% if _siteMetaData.feedback %}
        <li>
          <a href="{{ _siteMetaData.feedback }}" rel="external"
            >Send feedback</a
          >
        </li>
      {% endif %}
    </ul>
  {% endunless %}
</footer>
