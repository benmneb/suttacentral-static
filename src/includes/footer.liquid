{% include "sitePagesMenu.liquid" %}
<footer>
  {% if _siteMetaData.description %}
    <p>{{ _siteMetaData.description }}</p>
  {% endif %}
  <p>
    View this page on
    <a id="sc-redirect" href="{{ scOrigin }}/{{ route }}">SuttaCentral.net</a>
  </p>
  {% if fetchedAt %}
    <p id="updated">
      This page was last updated from SuttaCentral.net on<br>
      {{ fetchedAt | split: ", " | last }}
    </p>
  {% endif %}
  {% unless page.url == "/404.html" %}
    {% capture canonical %}{{ _siteMetaData.origin }}{{ page.url | url | route | uri_escape }}{% endcapture %}
    <p>
      This page is
      <a href="https://validator.w3.org/nu/?doc={{ canonical | url_encode }}"
        >W3C-valid HTML</a
      >
      and targets
      {% if _siteMetaData.accessibility -%}
        <a href="{{ _siteMetaData.accessibility }}">WCAG 2.2 AA</a>
      {%- else -%}
        WCAG 2.2 AA
      {%- endif %}
    </p>
  {% endunless %}
  {% unless _siteMetaData.source == blank
    and _siteMetaData.analytics == blank
    and _siteMetaData.archive == blank
    and _siteMetaData.suggestions == blank
    and _siteMetaData.contact == blank
  %}
    <ul>
      {% if _siteMetaData.source %}
        <li>
          <a href="{{ _siteMetaData.source }}">Open source</a>
        </li>
      {% endif %}
      {% if _siteMetaData.analytics %}
        <li>
          <a href="{{ _siteMetaData.analytics }}">Open analytics</a>
        </li>
      {% endif %}
      {% if _siteMetaData.archive %}
        <li>
          <a href="{{ _siteMetaData.archive }}">Use offline</a>
        </li>
      {% endif %}
      {% if _siteMetaData.suggestions %}
        <li>
          <a href="{{ _siteMetaData.suggestions }}">Send feedback</a>
        </li>
      {% elsif _siteMetaData.contact %}
        <li>
          <a href="mailto:{{ _siteMetaData.contact }}?subject=%5BSCX%5D%20Re%3A%20{{ route | url_encode }}"
            >Send feedback</a
          >
        </li>
      {% endif %}
    </ul>
  {% endunless %}
</footer>
