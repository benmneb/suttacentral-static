<!-- This has it's own file because it's used in text.liquid as well -->
{% unless isPatimokkha %}
  <hgroup>
    <h1>
      {%- if rangeTitle -%}
        {{ rangeTitle }}
      {%- else -%}
        {% rootTitle entry %}
      {%- endif -%}
    </h1>
    {%- if entry.acronym %}
      {% comment %} Not on a sutta within a range, as these are the whole range's {% endcomment %}
      {% if entry.scx_range_sutta_individual %}
        {% assign alt_acronym = "" %}
        {% assign volpages = "" %}
        {% assign alt_volpages = "" %}
      {% else %}
        {% assign alt_acronym = entry.alt_acronym %}
        {% assign volpages = entry.volpages | formatVolpages %}
        {% assign alt_volpages = entry.alt_volpages | formatVolpages %}
      {% endif %}
      <p class="text-refs" data-pagefind-weight="10">
        {%- textRefs entry.acronym, alt_acronym, "", volpages, alt_volpages -%}
      </p>
    {% endif -%}
  </hgroup>

  <p data-pagefind-ignore="all">{{ entry.blurb }}</p>
{% endunless %}

<div class="texts-list" data-pagefind-ignore="all">
  {% include "translationsDetails.liquid",
    entry: entry,
    translations: translations
  %}

  {% if entry._parallels_data and entry._parallels_data.size > 0 %}
    {% include "parallelsDetails.liquid",
      entry: entry,
      parallelsOpen: parallelsOpen
    %}
  {% endif %}
</div>
