<!-- This has it's own file because it's used in text.liquid as well -->
{% unless isPatimokkha %}
  <hgroup>
    <h1>
      {%- if rangeTitle -%}
        {{ rangeTitle }}
      {%- else -%}
        {% rootTitle entry %}
      {%- endif -%}
    </h1>
    {%- if entry.acronym %}
      {% assign volpages = entry.volpages | formatVolpages %}
      {% assign alt_volpages = entry.alt_volpages | formatVolpages %}
      {% comment %}
        Not on a sutta within a range, as the pages are the whole range's.
        No space before the ∙, so a line only wraps after it
      {% endcomment %}
      <p data-pagefind-weight="10">
        {{- entry.acronym | strip -}}
        {%- unless entry.scx_range_sutta_individual -%}
          {%- if volpages != blank -%}
            <span class="volpages"
              ><span aria-hidden="true">∙</span>
              <span title="Volume and page">{{ volpages }}</span></span
            >
          {%- endif -%}
          {%- if alt_volpages != blank and alt_volpages != volpages -%}
            <span class="volpages"
              ><span aria-hidden="true">∙</span>
              <span title="Volume and page">{{ alt_volpages }}</span></span
            >
          {%- endif -%}
        {%- endunless -%}
      </p>
    {% endif -%}
  </hgroup>

  <p data-pagefind-ignore="all">{{ entry.blurb }}</p>
{% endunless %}

<section class="texts-list" data-pagefind-ignore="all">
  {% include "translationsDetails.liquid",
    entry: entry,
    translations: translations
  %}

  {% if entry._parallels_data and entry._parallels_data.size > 0 %}
    {% include "parallelsDetails.liquid",
      entry: entry,
      parallelsOpen: parallelsOpen
    %}
  {% endif %}
</section>
