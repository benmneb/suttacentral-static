{% comment %} With `typed`, each has a title saying its type, for a list not headed by it {% endcomment %}
{% for parallel in parallels %}
  <li
    class="parallel-list-item-{{ parallel.to.type }}"
    {% if typed %}
      title="{% if parallel.to.type == 'full' %}Full parallel: different versions of the same text{% elsif parallel.to.type == 'mention' %}Mention: one text is quoted or mentioned in another{% elsif parallel.to.type == 'retelling' %}Retelling: the events of one text are retold in another{% endif %}"
    {% endif %}
  >
    {% comment %} Only English and root texts are built, see `filterTranslations` in `_masterData.js` {% endcomment %}
    {% assign built_trans = null %}
    {% for trans in parallel.to.translations %}
      {% if trans.lang == "en" or trans.lang == parallel.to.root_lang %}
        {% assign built_trans = trans %}
        {% break %}
      {% endif %}
    {% endfor %}
    {% assign anchor = "" %}
    {% if parallel.to.to contains "#" %}
      {% assign anchor = parallel.to.to | split: "#" | last | prepend: "#" %}
    {% endif %}
    {% assign href = "" %}
    {% if built_trans %}
      {% capture href -%}
        /{{ parallel.to.uid }}/{{ built_trans.lang }}/{{ built_trans.author_uid }}{{ anchor }}
      {%- endcapture %}
    {% endif %}
    {% if parallel.to.original_title != blank
      or parallel.to.translated_title != blank
    %}
      {% rootTitle parallel.to, href %}
      {% assign acronym = parallel.to.acronym | strip %}
    {% else %}
      {% if href != blank %}
        <a href="{{ href }}" hreflang="{{ built_trans.lang }}">
          {{- parallel.to.acronym | strip -}}
        </a>
      {% else %}
        <span>{{ parallel.to.acronym | strip }}</span>
      {% endif %}
      {% assign acronym = "" %}
    {% endif %}
    {% assign pretty_volpages = parallel.to.volpages | formatVolpages %}
    {% if acronym != blank or pretty_volpages != blank %}
      <br>
      {{- acronym -}}
      {%- if acronym != blank and pretty_volpages != blank %}
        <span aria-hidden="true">∙</span>
      {% endif -%}
      {{- pretty_volpages -}}
    {% endif %}
    {% if parallel.to.scx_translations.size > 0 %}
      <br>
      English:
      {% for trans in parallel.to.scx_translations -%}
        <a
          href="/{{ parallel.to.uid }}/{{ trans.lang }}/{{ trans.author_uid }}{{ anchor }}"
          hreflang="{{ trans.lang }}"
        >
          {{- trans.author | strip -}}
        </a>
        {%- unless forloop.last %}
          <span aria-hidden="true">∙</span>
        {% endunless -%}
      {%- endfor %}
    {% endif %}
  </li>
{% endfor %}
