{% comment %} With `typed`, each has a title saying its type, for a list not headed by it {% endcomment %}
{% for parallel in parallels %}
  {% assign type = parallel.to.scx_type | default: parallel.to.type %}
  <li
    class="parallel-list-item-{{ type }}"
    {% if typed %}
      title="{% if type == 'full' %}Full parallel: different versions of the same text{% elsif type == 'resembling' %}Resembling parallel: texts are comparable{% elsif type == 'mention' %}Mention: one text is quoted or mentioned in another{% elsif type == 'retelling' %}Retelling: the events of one text are retold in another{% endif %}"
    {% endif %}
  >
    {% comment %} Only English and root texts are built, see `filterTranslations` in `_masterData.js` {% endcomment %}
    {% assign built_trans = null %}
    {% for trans in parallel.to.translations %}
      {% if trans.lang == "en" or trans.lang == parallel.to.root_lang %}
        {% assign built_trans = trans %}
        {% break %}
      {% endif %}
    {% endfor %}
    {% assign anchor = parallel.to.scx_anchor %}
    {% assign href = "" %}
    {% if built_trans %}
      {% capture href -%}
        /{{ parallel.to.uid }}/{{ built_trans.lang }}/{{ built_trans.author_uid }}{{ anchor }}
      {%- endcapture %}
    {% endif %}
    {% if parallel.to.original_title != blank
      or parallel.to.translated_title != blank
    %}
      {% rootTitle parallel.to, href %}
    {% elsif href != blank %}
      <a href="{{ href }}" hreflang="{{ built_trans.lang }}">
        {{- parallel.to.scx_label -}}
      </a>
    {% else %}
      <span>{{ parallel.to.scx_label }}</span>
    {% endif %}
    {% capture details -%}
      {%- for part in parallel.to.scx_details -%}
        {{- part -}}
        {%- unless forloop.last %}
          <span aria-hidden="true">∙</span>
        {% endunless -%}
      {%- endfor -%}
    {%- endcapture %}
    {% if parallel.to.scx_has_notes %}
      <details class="parallel-notes">
        <summary title="Notes">
          {{- details }}
          {% icon "informationCircle" %}
          {%- if details == blank -%}
            <span class="sr-only">Notes</span>
          {%- endif -%}
        </summary>
        {% for remark in parallel.to.scx_remarks %}
          <p>{{ remark }}</p>
        {% endfor %}
        {% if parallel.to.scx_volpages_full %}
          <p>{{ parallel.to.scx_volpages_full }}</p>
        {% endif %}
        {% if parallel.to.biblio %}
          <p>{{ parallel.to.biblio }}</p>
        {% endif %}
      </details>
    {% elsif details != blank %}
      <br>
      {{- details -}}
    {% endif %}
    {% if parallel.to.scx_translations.size > 0 %}
      {% unless parallel.to.scx_has_notes %}<br>{% endunless %}
      English:
      {% for trans in parallel.to.scx_translations -%}
        <a
          href="/{{ parallel.to.uid }}/{{ trans.lang }}/{{ trans.author_uid }}{{ anchor }}"
          hreflang="{{ trans.lang }}"
        >
          {{- trans.author | strip -}}
        </a>
        {%- unless forloop.last %}
          <span aria-hidden="true">∙</span>
        {% endunless -%}
      {%- endfor %}
    {% endif %}
  </li>
{% endfor %}
