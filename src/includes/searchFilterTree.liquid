{% comment %}
  One checkbox per branch, its children only showing once it's checked (see styles.css).
  The id carries the path, as some uids (ie dhp) are in the tree more than once
{% endcomment %}
{% for node in nodes %}
  {% assign id = path | append: "-" | append: node.uid %}
  <li>
    <input type="checkbox" name="in" value="{{ node.uid }}" id="in{{ id }}">
    <label for="in{{ id }}">
      {{- node.name -}}
      {% if node.lang %}
        <span class="root-lang">(from {{ node.lang }})</span>
      {%- endif -%}
      {% if node.reference %}
        <span class="collection-reference">{{ node.reference }}</span>
      {%- endif -%}
    </label>
    {% if node.children.size > 0 %}
      <ul>
        {% include "searchFilterTree.liquid", nodes: node.children, path: id %}
      </ul>
    {% endif %}
  </li>
{% endfor %}
