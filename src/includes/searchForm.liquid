<form
  action="https://duckduckgo.com"
  method="get"
  role="search"
  id="search-form"
>
  <label for="search-input" class="sr-only">Search</label>
  <input
    id="search-input"
    type="search"
    placeholder="Search…"
    autocomplete="off"
    name="q"
    required
    autofocus
  >
  <input
    type="hidden"
    name="sites"
    value="{{ _siteMetaData.origin | hostname }}"
  >
  <button aria-label="Search" type="submit">
    {% icon "magnifyingGlass", "mini" %}
  </button>
</form>
