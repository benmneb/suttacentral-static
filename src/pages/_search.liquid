---
layout: base.liquid

permalink: 'search/index.html'
eleventyExcludeFromCollections: true

eleventyComputed:
  title: 'Search'
  scripts:
    - 'search.js'
---
<header>
  {% include "headerNav.liquid", excludeSearch: true %}
</header>

<main>
  <h1>Search</h1>
  {% include "searchForm.liquid" %}
  <search aria-label="Filter results">
    <p
      id="search-count"
      role="status"
      hidden
    ></p>
    {% comment %} Filtering needs search.js, which unhides it {% endcomment %}
    <details id="search-filters" hidden>
      <summary>Filter</summary>
      <fieldset>
        <legend>Include in search</legend>
        <ul>
          <li>
            <input type="checkbox" id="search-texts" checked>
            <label for="search-texts">Texts</label>
            <ul>
              <li>
                <input type="checkbox" id="search-titles">
                <label for="search-titles">Titles only</label>
              </li>
            </ul>
          </li>
          <li>
            <input type="checkbox" id="search-notes">
            <label for="search-notes">Translators' notes</label>
          </li>
          <li>
            <input type="checkbox" id="search-site">
            <label for="search-site">Site pages</label>
          </li>
        </ul>
      </fieldset>
      <fieldset>
        <legend>Collection</legend>
        <ul id="search-filters-collection">
          {% include "searchFilterTree.liquid",
            nodes: searchFilterData.tree,
            path: ""
          %}
        </ul>
      </fieldset>
      <fieldset>
        <legend>Language</legend>
        <ul class="columns">
          {% for language in searchFilterData.languages %}
            <li>
              <input
                type="checkbox"
                name="lang"
                value="{{ language.uid }}"
                id="lang-{{ language.uid }}"
              >
              <label for="lang-{{ language.uid }}">{{ language.name }}</label>
            </li>
          {% endfor %}
        </ul>
      </fieldset>
      <fieldset>
        <legend>Author</legend>
        <ul id="search-filters-author">
          {% comment %}
            The group has no name, so it's no filter of its own,
            but checking it alone means everyone in it (see search.js)
          {% endcomment %}
          {% for group in searchFilterData.authorGroups %}
            {% assign groupId = group.name
              | slugify
              | prepend: "author-group-"
            %}
            <li>
              <input type="checkbox" id="{{ groupId }}">
              <label for="{{ groupId }}">{{ group.name }}</label>
              <ul class="columns">
                {% for author in group.authors %}
                  <li>
                    <input
                      type="checkbox"
                      name="author"
                      value="{{ author.uid }}"
                      id="author-{{ author.uid }}"
                    >
                    <label for="author-{{ author.uid }}">
                      {{- author.name -}}
                    </label>
                  </li>
                {% endfor %}
              </ul>
            </li>
          {% endfor %}
        </ul>
      </fieldset>
      <fieldset>
        <legend>Show above results</legend>
        <ul>
          <li>
            <input type="checkbox" id="search-dictionary-results" checked>
            <label for="search-dictionary-results">Pāli definitions</label>
          </li>
          <li>
            <input type="checkbox" id="search-site-pages-results" checked>
            <label for="search-site-pages-results">Quick site page links</label>
          </li>
        </ul>
      </fieldset>
    </details>
  </search>
  <aside
    id="search-dictionary"
    aria-labelledby="search-dictionary-heading"
    data-definitions-label="Pāli definitions for"
    data-all-label="All Pāli dictionaries"
    hidden
  ></aside>
  <aside id="search-site-pages" aria-label="Site pages" hidden>
    <ul class="further-reading"></ul>
  </aside>
  <template id="search-site-page-cards">
    {% for card in sitePagesData.searchCards %}
      <li
        data-names="{{ card.names }}"
        data-category="{{ card.category }}"
        data-tags="{{ card.tags }}"
      >
        <a href="{{ card.href }}"
          ><i class="icon i-{{ card.icon }}"></i
          ><cite>{{ card.title }}</cite></a
        >
        {% if card.byline %}
          <span>{{ card.byline }}</span>
        {% endif %}
        {% if card.edition %}
          <span class="tagline">
            A SuttaCentral Edition available in print and multiple digital
            formats for offline reading
          </span>
        {% endif %}
      </li>
    {% endfor %}
  </template>
  <ul
    id="search-results"
    aria-live="polite"
    aria-label="Search results"
    aria-atomic="false"
  ></ul>
  <nav aria-label="Search results pagination">
    <button
      id="show-more"
      class="button"
      type="button"
      hidden
      aria-label="Show more results"
    >
      Show more
    </button>
  </nav>
</main>

{% include "footer.liquid", route: "search" %}
