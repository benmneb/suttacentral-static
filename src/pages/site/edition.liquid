---
layout: sitePage.liquid
fetchedFrom: editions
mainClass: edition

pagination:
  data: sitePagesData.editionPages
  size: 1
  alias: entry
  addAllPagesToCollections: true

permalink: '/{{ entry.scx_path }}/index.html'
eleventyComputed:
  title: '{{ entry.title }}—{{ entry.publication.creator_name }}'
  crumb: '{{ entry.title }}'
  crumbs:
    - name: '{{ "publication:editionsToolbarTitle" | t | strip_html }}'
      href: /editions
---
{% assign publication = entry.publication %}
<article>
  <hgroup>
    <h1>{{ entry.title }}</h1>
    {% if publication.translation_subtitle %}
      <p>{{ publication.translation_subtitle }}</p>
    {% endif %}
    <p>{{ publication.creator_name }}</p>
  </hgroup>

  <section>
    <header>
      <h2>This translation</h2>
      <p>{{ publication.text_description }}</p>
      {% if entry.matter.size > 0 %}
        <nav aria-label="Book sections">
          <p>Preview:</p>
          <ul>
            {% for matter in entry.matter %}
              <li>
                <a href="/{{ matter.scx_path }}">{{ matter.label }}</a>
              </li>
            {% endfor %}
          </ul>
        </nav>
      {% endif %}
    </header>
    <figure>
      {% capture cover %}{{ scOrigin }}/img/publication-pages/{{ entry.uid }}-book.jpg{% endcapture %}
      {% capture alt %}Cover art for {{ entry.title }}{% endcapture %}
      {% siteImage cover, alt, 600, "high" %}
      <figcaption>Paperback edition of {{ entry.title }}</figcaption>
    </figure>
  </section>

  <div>
    <table>
      <caption>
        Get this book
      </caption>
      <tbody>
        {% for volume in entry.volumes %}
          <tr>
            {% if forloop.first %}
              <th scope="row" rowspan="{{ entry.volumes.size }}">Paperback</th>
            {% endif %}
            <td>
              <a href="{{ volume.volume_lulu_url }}" rel="external">
                {%- if volume.volume_number -%}
                  Buy Volume {{ volume.volume_number | slice: 3, 9 }}
                {%- else -%}
                  Buy on Lulu
                {%- endif -%}
              </a>
            </td>
          </tr>
        {% endfor %}
        {% if entry.files.epub %}
          <tr>
            <th scope="row">EPUB</th>
            <td>
              <a
                href="{{ entry.files.epub.download_url }}"
                rel="external"
                download
              >
                Download
              </a>
            </td>
          </tr>
        {% endif %}
        {% if entry.files.pdf %}
          <tr>
            <th scope="row">PDF</th>
            <td>
              <a
                href="{{ entry.files.pdf.download_url }}"
                rel="external"
                download
              >
                Download
              </a>
            </td>
          </tr>
        {% endif %}
        {% if entry.files.html %}
          <tr>
            <th scope="row">
              HTML
              <small class="with-icon">
                <span>(right click</span>
                {% icon "arrowRight" %}
                <span>save)</span>
              </small>
            </th>
            <td>
              <a
                href="{{ entry.files.html.download_url }}"
                rel="external"
                download
              >
                Download
              </a>
            </td>
          </tr>
        {% endif %}
        {% if entry.files.tex %}
          <tr>
            <th scope="row">LaTeX</th>
            <td>
              <a
                href="{{ entry.files.tex.download_url }}"
                rel="external"
                download
              >
                Download
              </a>
            </td>
          </tr>
        {% endif %}
        <tr>
          <th scope="row">Web</th>
          <td>
            <a href="{{ entry.readHref }}">Read on {{ _siteMetaData.title }}</a>
          </td>
        </tr>
      </tbody>
      {% if entry.files.updated %}
        <tfoot>
          <tr>
            <td colspan="2">Updated {{ entry.files.updated }}</td>
          </tr>
        </tfoot>
      {% endif %}
    </table>
  </div>

  {% if entry.menu %}
    <section>
      <h2>The {{ entry.menu.root_name }}</h2>
      {% if entry.menu.blurb %}
        <p>{{ entry.menu.blurb }}</p>
      {% endif %}
    </section>
  {% endif %}

  {% if entry.bio %}
    <section>
      <h2>The Author</h2>
      <figure>
        {% capture photo %}{{ scOrigin }}/img/publication-pages/{{ publication.creator_uid }}.jpg{% endcapture %}
        {% capture alt %}Photo of {{ publication.creator_name }}{% endcapture %}
        {% siteImage photo, alt, 300, "lazy" %}
        <figcaption>
          Bhante {{ publication.creator_uid | capitalize }}
        </figcaption>
      </figure>
      {{ entry.bio }}
    </section>
  {% endif %}

  <section>
    <h2>Publication details</h2>
    <dl>
      <dt>SuttaCentral publication number</dt>
      <dd>{{ publication.publication_number }}</dd>

      <dt>Source</dt>
      <dd>
        <a href="{{ publication.source_url }}" rel="external">
          {{- publication.source_url -}}
        </a>
      </dd>

      <dt>Text ID</dt>
      <dd>{{ publication.text_uid | upcase }}</dd>

      <dt>Publication status</dt>
      <dd>{{ publication.publication_status }}</dd>

      <dt>License</dt>
      <dd>
        <p>{{ publication.license_statement }}</p>
        <div>
          {% capture imageUrl %}{{ scOrigin }}/img/publication-pages/cc-zero.svg{% endcapture %}
          {% siteImage imageUrl, "", 62, "lazy" %}
          <p>
            <a rel="license external" href="{{ publication.license_url }}">
              {{- publication.license_type }}
              ({{ publication.license_abbreviation -}}
              )
            </a>
            <br>
            To the extent possible under law,
            {{ publication.creator_name }} has waived all copyright and related
            or neighboring rights to {{ entry.title }}. This work is published
            from Australia.
          </p>
        </div>
      </dd>
    </dl>
  </section>
</article>
