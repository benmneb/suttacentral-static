---
layout: sitePage.liquid
fetchedFrom: editions
mainClass: matter

pagination:
  data: sitePagesData.matterPages
  size: 1
  alias: entry
  addAllPagesToCollections: true

permalink: '/{{ entry.scx_path }}/index.html'
eleventyComputed:
  title: '{{ entry.label }}—{{ entry.editionTitle }}'
  crumb: '{{ entry.label }}'
  crumbs:
    - name: '{{ "publication:editionsToolbarTitle" | t | strip_html }}'
      href: /editions
  # Not in crumbs, as paged copies share its array, so every page gets the last one computed
  parentCrumb: '{{ entry.editionTitle }}'
  parentHref: '{{ entry.editionHref }}'
---
{{ entry.html }}
