  <figure>
    {% assign alt = "pirivenaPage:imageAlt" | t %}
    {% assign imageUrl = "https://suttacentral.net/img/static-pages/pirivena-monks-walking.jpg" %}
    {% siteImage imageUrl, alt %}
    <figcaption>{{ "pirivenaPage:photoCaption" | t | escape }}</figcaption>
  </figure>
  <p>{{ "pirivenaPage:1" | t | escape }}</p>
  <p>{{ "pirivenaPage:2" | t | escape }}</p>
  <p>{{ "pirivenaPage:3" | t | escape }}</p>
  <p>{{ "pirivenaPage:4" | t | escape }}</p>
  <p>{{ "pirivenaPage:5" | t | escape }}</p>
  <ul>
    <li>Vinayapiṭaka — 6 {{ "pirivenaPage:volumes" | t | escape }}</li>
    <li>Dīghanikāya — 3 {{ "pirivenaPage:volumes" | t | escape }}</li>
    <li>Majjhimanikāya — 3 {{ "pirivenaPage:volumes" | t | escape }}</li>
    <li>Saṁyuttanikāya — 5 {{ "pirivenaPage:volumes" | t | escape }}</li>
    <li>Aṅguttaranikāya — 5 {{ "pirivenaPage:volumes" | t | escape }}</li>
