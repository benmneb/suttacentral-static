  <p>{{ "pirivenaPage:7" | t | escape }}</p>
  <p>{{ "pirivenaPage:8" | t | escape }}</p>
  <p>
    {{ "pirivenaPage:contact" | t | escape }}: Deepika Weerakoon
    (suttacentraldevelopmenttrust@gmail.com).
  </p>
  <div class="donate-button-container">
    <a
      class="button"
      href="https://suttacentral-pirivena-pitaka.raiselysite.com/"
    >
      {{ "pirivenaPage:button" | t | escape }}
    </a>
  </div>
</article>
