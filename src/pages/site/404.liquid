---
layout: base.liquid

permalink: 404.html
eleventyExcludeFromCollections: true

title: 'Page not found'
headStyle: |
  .not-found ul { padding: 0; }
  .not-found li { list-style: none; margin: 0.5rem 0; }
  .not-found .icon { color: inherit; }

eleventyComputed:
  scripts:
    - '404.js'
---
<header>
  {% include "headerNav.liquid" %}
</header>

<main class="not-found">
  <h1>Page not found</h1>
  <ul>
    <li>
      <a class="with-icon" href="/">
        {%- icon "home" -%}
        <span>Go home</span>
      </a>
    </li>
    <li>
      <a class="with-icon" href="/search">
        {%- icon "magnifyingGlass" -%}
        <span>Search for something</span>
      </a>
    </li>
    {% if _siteMetaData.feedback %}
      <li>
        <a
          class="with-icon"
          href="{{ _siteMetaData.feedback }}"
          rel="external"
        >
          {%- icon "flag" -%}
          <span>Report a missing page</span>
        </a>
      </li>
    {% endif %}
  </ul>
</main>

{% include "footer.liquid", route: "404" %}
