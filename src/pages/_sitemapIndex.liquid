---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
{%- comment -%} 40000 is the page size of _sitemap.liquid, under the protocol's 50,000 URLs a file {%- endcomment -%}
{%- assign sitemaps = collections.all.size | divided_by: 40000.0 | ceil -%}
<?xml version="1.0" encoding="utf-8"?>
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for number in (1..sitemaps) %}
  <sitemap>
    <loc>{{ _siteMetaData.origin }}/sitemap-{{ number }}.xml</loc>
  </sitemap>
  {% endfor %}
</sitemapindex>
