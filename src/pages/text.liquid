---
layout: base.liquid

pagination:
  data: textData
  size: 1
  alias: entry
  addAllPagesToCollections: true

permalink: '{{ entry.scx_path }}/index.html'
styles:
  - text.css
eleventyComputed:
  title: '{{ entry.scx_title | escape }}'
  json_ld: '{{ entry.scx_json_ld }}'
  og_tags: '{{ entry.scx_og_tags }}'
  scripts:
    - 'userPrefs.js'
    - 'viewSettings.js'
    - 'listen.js'
---
{% comment %} Not for a legacy text, whose info is its own footer {% endcomment %}
{% assign has_info = true %}
{% if entry._publication_info == blank %}
  {% if entry.is_root and entry._bilarasuttas_data.size > 0 %}
    {% assign has_info = false %}
  {% elsif entry.segmented %}
    {% assign has_info = false %}
  {% endif %}
{% endif %}
<a class="skip" href="#main">Skip to main content</a>
<header>
  {% capture breadcrumbsList %}
    {% for crumb in entry.scx_breadcrumb_trail %}
      <li>
        {% comment %}
          Only the nearest collection is a search filter (`in`), by uid, as /search takes in those under `dn`
          or `sutta` from search/collections.json, so both find dn1 with a smaller filter to download.
          Not the text itself, unless it's a branch too, ie the pātimokkhas.
          The text's own uid stays in the index next to its name, so searching ie "mn1" still finds it first
        {% endcomment %}
        {% if forloop.last %}
          {% capture label -%}
            {{ crumb.name }}
            {%- if crumb.name != crumb.uid %}<span class="sr-only"> {{ crumb.uid }}</span>{% endif %}
          {%- endcapture %}
          {% if entry.node_type != 'leaf' %}
            <a href="{{ crumb.href }}" data-uid="{{ crumb.uid }}" data-pagefind-body data-pagefind-weight="10" data-pagefind-filter="in[data-uid]">{{ label }}</a>
          {% else %}
            <a href="{{ crumb.href }}" data-uid="{{ crumb.uid }}" data-pagefind-body data-pagefind-weight="10">{{ label }}</a>
          {% endif %}
        {% else %}
          {% if forloop.rindex0 == 1 and entry.node_type == 'leaf' %}
            {% assign filter = ' data-pagefind-filter="in[data-uid]"' %}
          {% else %}
            {% assign filter = '' %}
          {% endif %}
          {% if crumb.href %}
            <a href="{{ crumb.href }}" data-uid="{{ crumb.uid }}"{{ filter }}>{{ crumb.name }}</a>
          {% else %}
            <span data-uid="{{ crumb.uid }}"{{ filter }}>{{ crumb.name }}</span>
          {% endif %}
        {% endif %}
      </li>
    {% endfor %}
    <li>
      <span aria-current="page">{{ entry.author | default: entry.author_uid | strip }}</span>
    </li>
  {% endcapture %}
  {% include "headerNav.liquid", breadcrumbsList: breadcrumbsList %}
  {% comment %} The ids `in:` finds this text by, ie bupj1 for pli-tv-bu-vb-pj1, or dhp5 for the page showing it {% endcomment %}
  {% unless entry.scx_unindexed %}
    {% for id in entry.scx_text_ids %}
      <span
        hidden
        data-text-id="{{ id }}"
        data-pagefind-filter="text[data-text-id]"
      ></span>
    {% endfor %}
  {% endunless %}
</header>

<aside>
  <fieldset>
    <ul>
      {% if entry.scx_toc.size > 0 %}
        <li>
          <button
            popovertarget="contents-menu"
            tabindex="0"
            aria-controls="contents-menu"
            aria-label="Table of contents"
            title="Table of contents"
            id="contents-button"
          >
            {% icon "numberedList" %}
          </button>
          <ol
            class="dropdown"
            popover
            aria-labelledby="contents-button"
            id="contents-menu"
            {% if entry.scx_toc_number_width != blank %}
              style="--toc-number-width: {{ entry.scx_toc_number_width }}"
            {% endif %}
          >
            {% for heading in entry.scx_toc %}
              <li
                data-level="{{ heading.level }}"
                {% if heading.isTitle %}
                  data-title
                {% endif %}
              >
                <a href="{{ heading.href }}">
                  {{- heading.html -}}
                </a>
              </li>
            {% endfor %}
          </ol>
        </li>
      {% endif %}
      {% if has_info %}
        <li>
          <button
            popovertarget="info"
            tabindex="0"
            aria-controls="info"
            aria-label="Show publication information"
            title="Show publication information"
            id="info-button"
          >
            {% icon "informationCircle" %}
          </button>
        </li>
      {% endif %}
      <li>
        <button
          popovertarget="views-menu"
          tabindex="0"
          aria-controls="views-menu"
          aria-label="Text display settings"
          title="Text display settings"
          id="views-button"
        >
          {% icon "eye" %}
        </button>
        <ul
          class="dropdown hotkeys-off"
          popover
          aria-labelledby="views-button"
          id="views-menu"
        >
          {% if entry.has_comment
            or entry._bilarasuttas_data.variant_text.size > 0
          %}
            <li>
              <label for="commenter">
                <span class="with-icon">
                  {% icon "chatBubbleBottomCenterText" -%}
                  <span>
                    {%- if entry.is_root %}Variants{% else %}Notes{% endif -%}
                  </span>
                </span>
                <kbd aria-hidden="true" title="Press N to cycle through these"
                  >N</kbd
                >
              </label>
              <input
                type="checkbox"
                id="commenter"
                checked
                aria-controls="commenter-inline"
              >
            </li>
            <li class="sub">
              <label for="commenter-inline">
                <span class="with-icon">
                  {% icon "bars3BottomLeft" -%}
                  <span>Inline</span>
                </span>
              </label>
              <input
                type="checkbox"
                id="commenter-inline"
                aria-controls="commenter-side"
              >
            </li>
            <li class="sub sub-sub">
              <label for="commenter-side">
                <span class="with-icon">
                  {% icon "bars3BottomRight" -%}
                  <span>Sidenotes</span>
                </span>
              </label>
              <input type="checkbox" id="commenter-side">
            </li>
          {% endif %}
          {% comment %} Word lookup's dictionary, for a Pāli or Chinese root text {% endcomment %}
          {% assign lookupLang = entry.root_lang %}
          {% if entry.is_root %}
            {% assign lookupLang = entry.lang %}
          {% endif %}
          {% assign lookupDict = "" %}
          {% if entry.segmented != blank %}
            {% if lookupLang == "pli" and lookup.pli %}
              {% assign lookupDict = "pli-en" %}
            {% elsif lookupLang == "lzh" and lookup.lzh %}
              {% assign lookupDict = "lzh-en" %}
            {% endif %}
          {% endif %}
          {% if entry.is_root and lookupDict != blank %}
            <li hidden>
              <label for="definer">
                <span class="with-icon">
                  {% icon "bookOpen" -%}
                  <span>Word lookup</span>
                </span>
                <kbd aria-hidden="true" title="Press D to toggle">D</kbd>
              </label>
              <input type="checkbox" id="definer" data-dict="{{ lookupDict }}">
            </li>
          {% endif %}
          {% if entry.is_root and lookupLang == "lzh" %}
            <li hidden>
              <label for="simplifier">
                <span class="with-icon">
                  {% icon "arrowPath" -%}
                  <span>Simplified (<span lang="zh-Hans">简体</span>)</span>
                </span>
                <kbd aria-hidden="true" title="Press C to toggle">C</kbd>
              </label>
              <input type="checkbox" id="simplifier">
            </li>
          {% endif %}
          {% unless entry.is_root or entry.segmented == blank %}
            <li>
              <label for="rooter">
                <span class="with-icon">
                  {% icon "language" -%}
                  <span>Root text</span>
                </span>
                <kbd aria-hidden="true" title="Press V to cycle through these"
                  >V</kbd
                >
              </label>
              <input
                type="checkbox"
                id="rooter"
                aria-controls="rooter-side rooter-first{% if lookupDict != blank %} definer{% endif %}{% if lookupLang == "lzh" %} simplifier{% endif %}"
              >
            </li>
            <li class="sub">
              <label for="rooter-side">
                <span class="with-icon">
                  {% icon "viewColumns" -%}
                  <span>Side by side</span>
                </span>
              </label>
              <input type="checkbox" id="rooter-side">
            </li>
            <li class="sub">
              <label for="rooter-first">
                <span class="with-icon">
                  {% icon "arrowsUpDown" -%}
                  <span>Root first</span>
                </span>
                <kbd aria-hidden="true" title="Press F to toggle">F</kbd>
              </label>
              <input type="checkbox" id="rooter-first">
            </li>
            {% if lookupDict != blank %}
              <li class="sub" hidden>
                <label for="definer">
                  <span class="with-icon">
                    {% icon "bookOpen" -%}
                    <span>Word lookup</span>
                  </span>
                  <kbd aria-hidden="true" title="Press D to toggle">D</kbd>
                </label>
                <input
                  type="checkbox"
                  id="definer"
                  data-dict="{{ lookupDict }}"
                >
              </li>
            {% endif %}
            {% if lookupLang == "lzh" %}
              <li class="sub" hidden>
                <label for="simplifier">
                  <span class="with-icon">
                    {% icon "arrowPath" -%}
                    <span>Simplified (<span lang="zh-Hans">简体</span>)</span>
                  </span>
                  <kbd aria-hidden="true" title="Press C to toggle">C</kbd>
                </label>
                <input type="checkbox" id="simplifier">
              </li>
            {% endif %}
          {% endunless %}
          {% if entry.scx_illustrations %}
            <li>
              <label for="illustrator">
                <span class="with-icon">
                  {% icon "photo" -%}
                  <span>Illustrations</span>
                </span>
                <kbd aria-hidden="true" title="Press G to toggle">G</kbd>
              </label>
              <input type="checkbox" id="illustrator" checked>
            </li>
          {% endif %}
          {% if entry.scx_has_highlights %}
            <li>
              <label for="highlighter" title="Highlight text-critical details">
                <span class="with-icon">
                  {% icon "paintBrush" -%}
                  <span>Highlighting</span>
                </span>
                <kbd aria-hidden="true" title="Press Z to toggle">Z</kbd>
              </label>
              <input
                type="checkbox"
                id="highlighter"
                title="Highlight text-critical details"
              >
            </li>
          {% endif %}
          {% if entry.scx_parallel_runs.size > 0 %}
            <li>
              <label for="paralleler">
                <span class="with-icon">
                  {% icon "arrowsRightLeft" -%}
                  <span>Parallels</span>
                </span>
                <kbd aria-hidden="true" title="Press X to toggle">X</kbd>
              </label>
              <input type="checkbox" id="paralleler">
            </li>
          {% endif %}
          {% if entry.segmented
            or entry._suttas_data.translation.text contains "class='ref"
          %}
            <li>
              <label for="segmenter">
                <span class="with-icon">
                  {% icon "hashtag" -%}
                  <span>References</span>
                </span>
                <kbd aria-hidden="true" title="Press R to toggle">R</kbd>
              </label>
              <input
                type="checkbox"
                id="segmenter"
                {% if entry.scx_reference_groups.size > 1 %}
                  aria-controls="{% for group in entry.scx_reference_groups %}segmenter-{{ group }}{% unless forloop.last %} {% endunless %}{% endfor %}"
                {% endif %}
              >
            </li>
            {% comment %} With only one group the References checkbox says it all {% endcomment %}
            {% if entry.scx_reference_groups.size > 1 %}
              {% if entry.scx_reference_groups contains "main" %}
                <li class="sub">
                  <label for="segmenter-main" title="SuttaCentral">
                    <span class="with-icon">
                      {% icon "bookmark" -%}
                      <span>Main</span>
                    </span>
                    <kbd aria-hidden="true" title="Press M to toggle">M</kbd>
                  </label>
                  <input
                    type="checkbox"
                    id="segmenter-main"
                    title="SuttaCentral"
                    checked
                  >
                </li>
              {% endif %}
              {% if entry.scx_reference_groups contains "pts" %}
                <li class="sub">
                  <label
                    for="segmenter-pts"
                    title="{{ 'pts' | referenceEdition }}"
                  >
                    <span class="with-icon">
                      {% icon "document" -%}
                      <span>PTS</span>
                    </span>
                    <kbd aria-hidden="true" title="Press T to toggle">T</kbd>
                  </label>
                  <input
                    type="checkbox"
                    id="segmenter-pts"
                    title="{{ 'pts' | referenceEdition }}"
                  >
                </li>
              {% endif %}
              {% if entry.scx_reference_groups contains "others" %}
                <li class="sub">
                  <label
                    for="segmenter-others"
                    title="{{ entry.scx_other_editions }}"
                  >
                    <span class="with-icon">
                      {% icon "rectangleStack" -%}
                      <span>Others</span>
                    </span>
                  </label>
                  <input
                    type="checkbox"
                    id="segmenter-others"
                    title="{{ entry.scx_other_editions }}"
                  >
                </li>
              {% endif %}
            {% endif %}
          {% endif %}
          <li hidden>
            <label
              for="shortcutter"
              title="Single-key shortcuts for these settings and Listen"
            >
              <span class="with-icon">
                {% icon "commandLine" -%}
                <span>Hot keys</span>
              </span>
            </label>
            <input
              type="checkbox"
              id="shortcutter"
              title="Single-key shortcuts for these settings and Listen"
              checked
            >
          </li>
          <li>
            <label for="positioner">
              <span class="with-icon">
                {% icon "mapPin" -%}
                <span>Pin menu</span>
              </span>
              <kbd aria-hidden="true" title="Press B to toggle">B</kbd>
            </label>
            <input type="checkbox" id="positioner" checked>
          </li>
        </ul>
      </li>
      <li>
        <button
          popovertarget="parallels"
          tabindex="0"
          aria-controls="parallels"
          aria-label="Show parallel texts"
          title="Show parallel texts"
          id="parallels-button"
        >
          {% icon "arrowsRightLeft" %}
        </button>
      </li>
      <li>
        <button
          popovertarget="listen-menu"
          tabindex="0"
          aria-controls="listen-menu"
          aria-label="Text to speech settings"
          title="Text to speech settings"
          id="listen-menu-button"
        >
          {% icon "speakerWave" %}
        </button>
        <ul
          class="dropdown hotkeys-off"
          popover
          aria-labelledby="listen-menu-button"
          id="listen-menu"
          data-text-lang="{{ entry.lang | langTag }}"
        >
          <li class="notice">
            <noscript>
              Please enable javascript to listen to this text. It reads aloud in
              your browser with your device's own voices, via the
              SpeechSynthesis API, and most of them work offline.
            </noscript>
          </li>
          <li id="no-voices" class="notice" hidden>
            No voices found. Listen reads aloud with the text-to-speech voices
            installed on your device - add a voice in your system's speech
            settings, then reload the page.
          </li>
          <li class="tts-controls">
            <button id="prev" type="button" disabled>
              <span>{% icon "backward", "mini" %}</span
              ><span
                ><span>Prev</span
                ><kbd aria-hidden="true" title="Press H">H</kbd></span
              >
            </button>
            <button id="playpause" type="button">
              <span>{% icon "play", "mini" %}</span
              ><span
                ><span>Play</span
                ><kbd aria-hidden="true" title="Press J">J</kbd></span
              >
            </button>
            <template id="pause-icon">{% icon "pause", "mini" %}</template>
            <button id="stop" type="button" disabled>
              <span>{% icon "stop", "mini" %}</span
              ><span
                ><span>Stop</span
                ><kbd aria-hidden="true" title="Press K">K</kbd></span
              >
            </button>
            <button id="next" type="button" disabled>
              <span>{% icon "forward", "mini" %}</span
              ><span
                ><span>Next</span
                ><kbd aria-hidden="true" title="Press L">L</kbd></span
              >
            </button>
          </li>
          <li>
            <label for="voice-select" class="with-icon">
              {% icon "microphone" -%}
              <span data-also-a="Rate" data-also-b="Pitch">Voice</span>
            </label>
            <select id="voice-select"></select>
            <button
              id="voice-info-button"
              type="button"
              aria-expanded="false"
              aria-controls="voice-info"
              aria-label="About voices"
              title="About voices"
            >
              {% icon "informationCircle" %}
            </button>
          </li>
          <li id="voice-info" class="voice-info" hidden>
            <p>
              These voices all come from your device and browser. Higher quality
              voices are usually a free download in your system's speech or
              accessibility settings. Remember to reload the page after adding
              new ones.
            </p>
            {% comment %} Unhidden by the script for an online voice {% endcomment %}
            <p id="voice-info-online" hidden>
              Voices marked ONLINE send the text to the company that makes them,
              such as Google or Microsoft. The rest read it on your device.
            </p>
          </li>
          <li>
            <label for="rate" class="with-icon">
              {% icon "clock" -%}
              <span data-also-a="Voice" data-also-b="Pitch">Rate</span>
            </label>
            <input
              type="range"
              min="0.5"
              max="2"
              value="1"
              step="0.1"
              id="rate"
            >
            <div id="rate-value">1.0</div>
          </li>
          <li>
            <label for="pitch" class="with-icon">
              {% icon "musicalNote" -%}
              <span data-also-a="Voice" data-also-b="Rate">Pitch</span>
            </label>
            <input
              type="range"
              min="0"
              max="2"
              value="1"
              step="0.1"
              id="pitch"
            >
            <div id="pitch-value">1.0</div>
          </li>
          <li>
            <label for="auto-scroll">
              <span class="with-icon">
                {% icon "chevronDoubleDown" -%}
                <span>Auto-scroll</span>
              </span>
              <kbd aria-hidden="true" title="Press A to toggle">A</kbd>
            </label>
            <input type="checkbox" id="auto-scroll">
          </li>
        </ul>
      </li>
      <li class="aside-search">
        <button
          type="button"
          commandfor="search-modal"
          command="show-modal"
          aria-label="Search"
          title="Search"
        >
          {% icon "magnifyingGlass" %}
        </button>
      </li>
    </ul>
    <p id="views-status" class="sr-only" role="status"></p>
  </fieldset>
</aside>

{% unless entry.scx_unindexed %}
  {% assign title_parts = entry.original_title | titleParts %}
{% endunless %}
<span id="main" tabindex="-1"></span>
<main
  {% comment %} Not when another page indexes this text, nor its titles, as Pagefind searches meta (and the h1 without one) {% endcomment %}
  {% unless entry.scx_unindexed %}
    data-pagefind-body
  {% endunless %}
  data-acronym="{{ entry.acronym }}"
  data-author="{{ entry.author }}"
  data-authoruid="{{ entry.author_uid }}"
  data-lang="{{ entry.lang }}"
  data-title="{{ entry.translated_title | default: entry.translated_name }}"
  data-translatorstitle="{{ entry._suttas_data.translation.title | default: '' }}"
  data-originaltitle="{{ entry.original_title }}"
  data-rootlang="{{ entry.root_lang }}"
  {% if title_parts != blank %}
    data-titleparts="{{ title_parts }}"
  {% endif %}
  {% if entry.scx_unindexed %}
    data-pagefind-meta="acronym[data-acronym], author[data-author], lang[data-lang], title[data-acronym], rootLang[data-rootlang]"
  {% else %}
    data-pagefind-meta="acronym[data-acronym], author[data-author], lang[data-lang], title[data-title], translatorsTitle[data-translatorstitle], originalTitle[data-originaltitle], rootLang[data-rootlang]{% if title_parts != blank %}, titleParts[data-titleparts]{% endif %}"
  {% endif %}
  data-pagefind-filter="author[data-authoruid], lang[data-lang]"
  {% if entry.scx_parallel_lanes > 0 %}
    style="--parallel-lanes: {{ entry.scx_parallel_lanes }}"
  {% endif %}
>
  {% if entry.is_root and entry._bilarasuttas_data.size > 0 %}
    {% assign segments = entry | segmentsHtml: true %}
  {% elsif entry.segmented %}
    {% assign segments = entry | segmentsHtml: false %}
  {% endif %}
  {% if segments %}
    {{ segments.html }}
    {{ entry.scx_range_closing_tags }}
    {{ segments.comments }}
    {% if has_info %}
      <article id="info" popover>
        {% include "publicationInfo.liquid", entry: entry %}
      </article>
    {% endif %}
  {% else %}
    {% assign html_content = entry._suttas_data.translation.text
      | replace: "\n", ""
      | addReferenceGroups
    %}
    {% assign original_footer = html_content
      | split: "<footer"
      | last
      | split: "</footer>"
      | first
      | prepend: "<footer"
      | append: "</footer>"
    %}
    {% assign html_without_footer = html_content
      | replace: original_footer, ""
    %}
    {% assign modified_footer = original_footer
      | replace: "<footer", '<article id="info" popover'
      | replace: "</footer>", "</article>"
    %}
    {{ html_without_footer }}
    {{ modified_footer }}
  {% endif %}

  {% if entry.scx_parallel_runs.size > 0 %}
    <ol class="parallel-runs" aria-label="Parallels" data-pagefind-ignore="all">
      {% for run in entry.scx_parallel_runs %}
        <li>
          <button
            class="parallel-run"
            popovertarget="parallels-{{ forloop.index0 }}"
            data-type="{{ run.type }}"
            {% if run.outer %}
              data-outer
            {% endif %}
            aria-label="{{ run.label }}, {{ run.count }} parallel{% if run.count != 1 %}s{% endif %}"
            style="--lane: {{ run.lane }}; --from: --ps{{ run.start }}; --to: --ps{{ run.end }}"
          ></button>
          <article id="parallels-{{ forloop.index0 }}" popover>
            <h1>Parallels of {{ run.label }}</h1>
            {% for group in run.groups %}
              <section>
                <h2>{{ group.title }}</h2>
                <ul class="parallel-list">
                  {{ group.parallels | parallelItemsHtml: false }}
                </ul>
              </section>
            {% endfor %}
          </article>
        </li>
      {% endfor %}
    </ol>
  {% endif %}

  <article id="parallels" popover>
    {% include "textMetaContent.liquid",
      entry: entry,
      translations: entry._suttas_data.suttaplex.translations,
      parallelsOpen: true
    %}
  </article>
  {% if lookupDict != blank %}
    <article
      id="definition"
      popover
      aria-label="Word definition"
    ></article>
    <p id="definition-hint" hidden data-pagefind-ignore>
      Enter looks up its first
      {% if lookupDict == "lzh-en" %}character{% else %}word{% endif %}.
    </p>
  {% endif %}
</main>

<nav aria-label="Article pagination">
  <div>
    {% unless entry._suttas_data.translation.previous.uid == blank
      and entry.scx_range_sutta_pagination.prev.uid == blank
    %}
      <span id="pagination-prev" aria-hidden="true">Previous</span>
      <a
        id="pagination-prev-link"
        href="/{{ entry.scx_range_sutta_pagination.prev.uid | default: entry._suttas_data.translation.previous.uid }}{% if entry._suttas_data.translation.previous.lang %}/{{ entry._suttas_data.translation.previous.lang }}/{{ entry._suttas_data.translation.previous.author_uid }}{% endif %}"
        rel="prev"
        aria-labelledby="pagination-prev pagination-prev-link"
      >
        {{
          entry.scx_range_sutta_pagination.prev.name
          | default: entry._suttas_data.translation.previous.name
          | softHyphenateTitle
        }}
      </a>
    {% endunless %}
  </div>
  <div>
    {% unless entry._suttas_data.translation.next.uid == blank
      and entry.scx_range_sutta_pagination.next.uid == blank
    %}
      <span id="pagination-next" aria-hidden="true">Next</span>
      <a
        id="pagination-next-link"
        href="/{{ entry.scx_range_sutta_pagination.next.uid | default: entry._suttas_data.translation.next.uid }}{% if entry._suttas_data.translation.next.lang %}/{{ entry._suttas_data.translation.next.lang }}/{{ entry._suttas_data.translation.next.author_uid }}{% endif %}"
        rel="next"
        aria-labelledby="pagination-next pagination-next-link"
      >
        {{
          entry.scx_range_sutta_pagination.next.name
          | default: entry._suttas_data.translation.next.name
          | softHyphenateTitle
        }}
      </a>
    {% endunless %}
  </div>
</nav>

