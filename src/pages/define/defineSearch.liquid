---
layout: sitePage.liquid
fetchedFrom: dictionaries
mainClass: define-search
scripts:
  - define.js

pagination:
  data: defineData.index
  size: 1
  alias: built
  addAllPagesToCollections: true

permalink: /define/index.html
eleventyComputed:
  title: Pāli dictionary and definitions
  og_tags: '{{ built.scx_og_tags }}'
  json_ld: '{{ built.scx_json_ld }}'
---
<h1>Definitions</h1>
{% include "defineForm.liquid", autofocus: true %}

<footer class="sources" aria-labelledby="define-sources-heading">
  <h2 id="define-sources-heading">Sources</h2>
  <ul>
    {% for dictionary in defineData.dictionaries %}
      <li>
        {{ dictionary.title }}: {{ dictionary.count | formatNumber }} words
        {%- if dictionary.name == "dpd" %}
          <a href="https://dpdict.net" aria-label="dpdict.net"></a>
        {%- endif %}
      </li>
    {% endfor %}
  </ul>
</footer>
