---
layout: sitePage.liquid
fetchedFrom: dictionaries
mainClass: define
scripts:
  - define.js

pagination:
  data: defineData.pages
  size: 1
  alias: term
  addAllPagesToCollections: true

permalink: '/define/{{ term.word }}/index.html'
eleventyComputed:
  title: 'Pāli dictionary results for {{ term.word }}'
  og_tags: '{{ term.scx_og_tags }}'
  json_ld: '{{ term.scx_json_ld }}'
  crumb: '{{ term.word }}'
  crumbs:
    - name: Definitions
      href: /define
---
<hgroup>
  <h1>
    Definitions for <span lang="pli" translate="no">{{ term.word }}</span>
  </h1>
  <p>
    Found in {{ term.entries.size | formatNumber }}
    {% if term.entries.size == 1 %}dictionary{% else %}dictionaries{% endif %}
  </p>
</hgroup>
<section>
  <article>
    <dl>
      {% for entry in term.entries %}
        <dt class="{{ entry.name }}">
          {{- entry.title -}}
          {%- if entry.name == "dpd" %}
            <a
              href="https://dpdict.net/?q={{ term.word | url_encode }}"
              aria-label="{{ term.word }} in the Digital Pāḷi Dictionary"
            ></a>
          {%- endif %}
        </dt>
        {% if entry.grammar %}
          <dd>
            <em>{{ entry.grammar }}</em>
          </dd>
        {% endif %}
        {% if entry.mapTag %}
          {% assign place = sitePagesData.map.places[entry.mapView] %}
          {% capture mapLink %}
            {%- if place and sitePagesData.map.base -%}
              {% include "miniMap.liquid", place: place %}
            {%- elsif place -%}
              <p class="on-map">
                <a href="/map#{{ place.id }}">{% icon "mapPin" %}On the map</a>
              </p>
            {%- endif -%}
          {% endcapture %}
          <dd>{{ entry.html | replace: entry.mapTag, mapLink }}</dd>
        {% elsif entry.html %}
          <dd>{{ entry.html }}</dd>
        {% endif %}
        {% if entry.definitions.size > 0 %}
          <dd>
            {% if entry.numbered %}
              <ol>
                {% for definition in entry.definitions %}
                  <li>{{ definition }}</li>
                {% endfor %}
              </ol>
            {% else %}
              {{ entry.definitions | join: "; " }}
            {% endif %}
          </dd>
        {% endif %}
        {% if entry.xrs.size > 0 %}
          <dd>
            <ul>
              {% for xr in entry.xrs %}
                <li lang="pli" translate="no">
                  {%- if xr.word -%}
                    <a href="{{ xr.word | defineHref }}">{{ xr.text }}</a>
                  {%- else -%}
                    {{ xr.text }}
                  {%- endif -%}
                </li>
              {% endfor %}
            </ul>
          </dd>
        {% endif %}
      {% endfor %}
    </dl>
  </article>
  <nav aria-label="Other words">
    {% include "defineForm.liquid" %}
    {% if term.adjacent.size > 0 %}
      <article>
        <h2>Adjacent Terms</h2>
        <ol>
          {% for word in term.adjacent %}
            {% if word == term.word %}
              <li class="no-list-item">
                <span aria-current="page" lang="pli" translate="no">
                  {{- word -}}
                </span>
              </li>
            {% else %}
              <li>
                <a href="{{ word | defineHref }}" lang="pli" translate="no">
                  {{- word -}}
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ol>
      </article>
    {% endif %}
    {% if term.similar.size > 0 %}
      <article>
        <h2>Similar Spelling</h2>
        <ol>
          {% for word in term.similar %}
            <li>
              <a href="{{ word | defineHref }}" lang="pli" translate="no">
                {{- word -}}
              </a>
            </li>
          {% endfor %}
        </ol>
      </article>
    {% endif %}
  </nav>
</section>
