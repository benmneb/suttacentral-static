---
layout: sitePage.liquid
fetchedFrom: dictionaries
mainClass: define
scripts:
  - define.js

pagination:
  data: defineData.pages
  size: 1
  alias: term
  addAllPagesToCollections: true

permalink: '/define/{{ term.word }}/index.html'
eleventyComputed:
  title: 'Pāli dictionary results for {{ term.word }}'
  og_tags: '{{ term.scx_og_tags }}'
  json_ld: '{{ term.scx_json_ld }}'
---
<hgroup>
  <h1>
    Definitions for <span lang="pi" translate="no">{{ term.word }}</span>
  </h1>
  <p>
    Found in {{ term.entries.size | formatNumber }}
    {% if term.entries.size == 1 %}dictionary{% else %}dictionaries{% endif %}
  </p>
</hgroup>
<div>
  <dl>
    {% for entry in term.entries %}
      {% comment %} One dt for a dictionary's several entries, ie NCPED's homonyms, as a dl can't name two the same {% endcomment %}
      {% if entry.name == previous_name %}
        {% assign dd = '<dd class="again">' %}
      {% else %}
        <dt class="{{ entry.name }}">
          {{- entry.title -}}
          {%- if entry.name == "dpd" %}
            <a
              href="https://dpdict.net/?q={{ term.word | url_encode }}"
              rel="external"
              aria-label="{{ term.word }} in the Digital Pāḷi Dictionary (external link)"
            ></a>
          {%- endif %}
        </dt>
        {% assign dd = "<dd>" %}
      {% endif %}
      {% assign previous_name = entry.name %}
      {% if entry.grammar %}
        {{ dd -}}
        {%- assign dd = "<dd>" %}
        <em>{{ entry.grammar }}</em>
        </dd>
      {% endif %}
      {% if entry.mapTag %}
        {% assign place = sitePagesData.map.places[entry.mapView] %}
        {% capture mapLink %}
            {%- if place and sitePagesData.map.base -%}
              {% include "miniMap.liquid", place: place %}
            {%- elsif place -%}
              <p class="on-map">
                <a href="/map#{{ place.id }}">{% icon "mapPin" %}On the map</a>
              </p>
            {%- endif -%}
          {% endcapture %}
        {{ dd -}}
        {%- assign dd = "<dd>" -%}
        {{- entry.html | replace: entry.mapTag, mapLink }}
        </dd>
      {% elsif entry.html %}
        {{ dd -}}
        {%- assign dd = "<dd>" -%}
        {{- entry.html }}
        </dd>
      {% endif %}
      {% if entry.definitions.size > 0 %}
        {{ dd -}}
        {%- assign dd = "<dd>" %}
        {% if entry.numbered %}
          <ol>
            {% for definition in entry.definitions %}
              <li>{{ definition }}</li>
            {% endfor %}
          </ol>
        {% else %}
          {{ entry.definitions | join: "; " }}
        {% endif %}
        </dd>
      {% endif %}
      {% if entry.xrs.size > 0 %}
        {{ dd -}}
        {%- assign dd = "<dd>" %}
        <ul>
          {% for xr in entry.xrs %}
            <li lang="pi" translate="no">
              {%- if xr.word -%}
                <a href="{{ xr.word | defineHref }}">{{ xr.text }}</a>
              {%- else -%}
                {{ xr.text }}
              {%- endif -%}
            </li>
          {% endfor %}
        </ul>
        </dd>
      {% endif %}
    {% endfor %}
  </dl>
  <nav aria-label="Other words">
    {% include "defineForm.liquid" %}
    {% if term.adjacent.size > 0 %}
      <article>
        <h2>Adjacent Terms</h2>
        <ol>
          {% for word in term.adjacent %}
            {% if word == term.word %}
              <li class="no-list-item">
                <span aria-current="page" lang="pi" translate="no">
                  {{- word -}}
                </span>
              </li>
            {% else %}
              <li>
                <a href="{{ word | defineHref }}" lang="pi" translate="no">
                  {{- word -}}
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ol>
      </article>
    {% endif %}
    {% if term.similar.size > 0 %}
      <article>
        <h2>Similar Spelling</h2>
        <ol>
          {% for word in term.similar %}
            <li>
              <a href="{{ word | defineHref }}" lang="pi" translate="no">
                {{- word -}}
              </a>
            </li>
          {% endfor %}
        </ol>
      </article>
    {% endif %}
  </nav>
</div>
