---
layout: base.liquid

pagination:
  data: chapterData
  size: 1
  alias: entry
  addAllPagesToCollections: true

permalink: '{{ entry.scx_path }}/index.html'
eleventyComputed:
  title: '{{ entry.scx_title | escape }}'
  json_ld: '{{ entry.scx_json_ld }}'
  og_tags: '{{ entry.scx_og_tags }}'
---
<a class="skip" href="#main">Skip to main content</a>
<header>
  {% capture breadcrumbsList %}
    {% for crumb in entry.scx_breadcrumb_trail %}
      <li>
        {% if forloop.last %}
          <span aria-current="page">{{ crumb.name }}</span>
        {% elsif crumb.href %}
          <a href="{{ crumb.href }}">{{ crumb.name }}</a>
        {% else %}
          <span>{{ crumb.name }}</span>
        {% endif %}
      </li>
    {% endfor %}
  {% endcapture %}
  {% include "headerNav.liquid", breadcrumbsList: breadcrumbsList %}
</header>

<main id="main">
  <h1>{% rootTitle entry %}</h1>

  {% if entry.blurb %}
    <p>{{ entry.blurb }}</p>
  {% endif %}

  {% include "furtherReading.liquid", uid: entry.uid %}

  {% assign isPatimokkha = entry.uid | endswith: "-pm" %}
  {% if isPatimokkha %}
    {% include "textMetaContent.liquid", entry: entry, isPatimokkha: true %}
  {% endif %}

  {% if isPatimokkha %}
    <details class="patimokkha-details">
      <summary>Details</summary>
  {% endif %}
  {% if entry.children.length %}
    <ul class="texts-list">
      {% for child in entry.children %}
        {% comment %} The id is where breadcrumbs link to for things with no page of their own, ie pātimokkha sections {% endcomment %}
        <li id="{{ child.uid }}">
          <hgroup>
            <h2>{% rootTitle child %}</h2>
            {%- if child.acronym %}
              <p>{{ child.acronym }}</p>
            {% endif %}
          </hgroup>
          {%- if child.blurb %}
            <p>{{ child.blurb }}</p>
          {% endif %}
          {% if child.translations.length %}
            {% include "translationsDetails.liquid", entry: child %}
          {% endif %}
          {% if child._parallels_data and child._parallels_data.size > 0 %}
            {% include "parallelsDetails.liquid", entry: child %}
          {% endif %}
          {% if isPatimokkha %}
            <ul>
              {% for grandchild in child.children %}
                <li>
                  <hgroup>
                    <h3>{% rootTitle grandchild %}</h3>
                    {%- if grandchild.acronym %}
                      <p>{{ grandchild.acronym }}</p>
                    {% endif %}
                  </hgroup>
                  {% if grandchild.blurb %}
                    <p>{{ grandchild.blurb }}</p>
                  {% endif %}
                  {% include "parallelsDetails.liquid", entry: grandchild %}
                </li>
              {% endfor %}
            </ul>
          {% endif %}
          {% if entry.scx_shortcut %}
            <ul>
              {% for grandchild in child.children %}
                <li>
                  <hgroup>
                    <h3>{% rootTitle grandchild %}</h3>
                    {%- if grandchild.acronym %}
                      <p>{{ grandchild.acronym }}</p>
                    {% endif %}
                  </hgroup>
                  {% if grandchild.blurb %}
                    <p>{{ grandchild.blurb }}</p>
                  {% endif %}
                  {% include "translationsDetails.liquid", entry: grandchild %}
                  {% if grandchild.parallel_count %}
                    {% include "parallelsDetails.liquid", entry: grandchild %}
                  {% endif %}
                  <ul>
                    {% for greatgrandchild in grandchild.children %}
                      <li>
                        <hgroup>
                          <h4>{% rootTitle greatgrandchild %}</h4>
                          {%- if greatgrandchild.acronym %}
                            <p>{{ greatgrandchild.acronym }}</p>
                          {% endif %}
                        </hgroup>
                        {% if greatgrandchild.blurb %}
                          <p>{{ greatgrandchild.blurb }}</p>
                        {% endif %}
                        {% include "translationsDetails.liquid",
                          entry: greatgrandchild
                        %}
                        {% if greatgrandchild.parallel_count %}
                          {% include "parallelsDetails.liquid",
                            entry: greatgrandchild
                          %}
                        {% endif %}
                      </li>
                    {% endfor %}
                  </ul>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% endif %}
  {% if isPatimokkha %}
    </details>
  {% endif %}
</main>

{% if entry.scx_chapter_pagination.prev or entry.scx_chapter_pagination.next %}
  <nav aria-label="Article pagination">
    <div>
      {% if entry.scx_chapter_pagination.prev.uid %}
        <span id="pagination-prev" aria-hidden="true">Previous</span>
        <a
          id="pagination-prev-link"
          href="/{{ entry.scx_chapter_pagination.prev.uid }}"
          rel="prev"
          aria-labelledby="pagination-prev pagination-prev-link"
        >
          {{- entry.scx_chapter_pagination.prev.name | softHyphenateTitle -}}
        </a>
      {% endif %}
    </div>
    <div>
      {% if entry.scx_chapter_pagination.next.uid %}
        <span id="pagination-next" aria-hidden="true">Next</span>
        <a
          id="pagination-next-link"
          href="/{{ entry.scx_chapter_pagination.next.uid }}"
          rel="next"
          aria-labelledby="pagination-next pagination-next-link"
        >
          {{- entry.scx_chapter_pagination.next.name | softHyphenateTitle -}}
        </a>
      {% endif %}
    </div>
  </nav>
{% endif %}

{% include "footer.liquid",
  route: entry.scx_path,
  fetchedAt: entry.scx_fetched_at
%}

{% if _siteMetaData.environment == "dev" %}
  <script>
    const data = {{ entry | jsonify }};
    console.log(data);
  </script>
{% endif %}
