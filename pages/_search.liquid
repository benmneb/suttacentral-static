---
layout: base.liquid

permalink: 'search/index.html'
eleventyExcludeFromCollections: true

eleventyComputed:
  title: 'Search'
  scripts:
    - 'search.js'
---
<header>
  {% include "headerNav.liquid", excludeSearch: true %}
</header>

<main>
  <h1>Search</h1>
  {% include "searchForm.liquid" %}
  <search aria-label="Filter results">
    <p
      id="search-count"
      role="status"
      hidden
    ></p>
    {% comment %} Filtering needs search.js, which unhides it {% endcomment %}
    <details id="search-filters" hidden>
      <summary>Filter</summary>
      <fieldset>
        <legend>Collection</legend>
        <ul id="search-filters-collection">
          {% include "searchFilterTree.liquid",
            nodes: searchFilterData.tree,
            path: ""
          %}
        </ul>
      </fieldset>
      <fieldset>
        <legend>Language</legend>
        <ul class="columns">
          {% for language in searchFilterData.languages %}
            <li>
              <input
                type="checkbox"
                name="lang"
                value="{{ language.uid }}"
                id="lang-{{ language.uid }}"
              >
              <label for="lang-{{ language.uid }}">{{ language.name }}</label>
            </li>
          {% endfor %}
        </ul>
      </fieldset>
      <fieldset>
        <legend>Author</legend>
        <ul id="search-filters-author">
          {% comment %}
            The group has no name, so it's no filter of its own,
            but checking it alone means everyone in it (see search.js)
          {% endcomment %}
          {% for group in searchFilterData.authorGroups %}
            {% assign groupId = group.name
              | slugify
              | prepend: "author-group-"
            %}
            <li>
              <input type="checkbox" id="{{ groupId }}">
              <label for="{{ groupId }}">{{ group.name }}</label>
              <ul class="columns">
                {% for author in group.authors %}
                  <li>
                    <input
                      type="checkbox"
                      name="author"
                      value="{{ author.uid }}"
                      id="author-{{ author.uid }}"
                    >
                    <label for="author-{{ author.uid }}">
                      {{- author.name -}}
                    </label>
                  </li>
                {% endfor %}
              </ul>
            </li>
          {% endfor %}
        </ul>
      </fieldset>
    </details>
  </search>
  <ul
    id="search-results"
    aria-live="polite"
    aria-label="Search results"
    aria-atomic="false"
  ></ul>
  <nav aria-label="Search results pagination">
    <button id="show-more" hidden aria-label="Show more results">
      Show more
    </button>
  </nav>
</main>

{% include "footer.liquid", route: "search" %}
