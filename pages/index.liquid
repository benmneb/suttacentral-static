---
layout: base.liquid

eleventyComputed:
  json_ld: '{{ indexData[0].scx_json_ld }}'
  og_tags: '{{ indexData[0].scx_og_tags }}'
---
<header>
  {% include "headerNav.liquid", isHome: true %}
</header>

<main>
  <h1>
    <span class="root-title"
      ><dfn lang="pli">Tipiṭaka</dfn
      ><span> the Three Baskets of the Buddhist canon</span></span
    >
  </h1>

  <ul>
    {% for item in indexData %}
      <li>
        <h2>
          {% capture href %}pitaka/{{ item.uid }}{% endcapture %}
          {% rootTitle item, href %}
        </h2>
        <p>{{ item.blurb }}</p>
      </li>
    {% endfor %}
  </ul>
</main>

{% include "footer.liquid", route: "", fetchedAt: indexData[0].scx_fetched_at %}

{% if _siteMetaData.environment == "dev" %}
  <script>
    const data = {{ indexData | jsonify }};
    console.log(data);
  </script>
{% endif %}
