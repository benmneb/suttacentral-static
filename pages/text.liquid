---
layout: base.liquid

pagination:
  data: textData
  size: 1
  alias: entry
  addAllPagesToCollections: true

permalink: '{{ entry.scx_path }}/index.html'
eleventyComputed:
  title: '{{ entry.acronym }}{% unless entry.scx_range_sutta_individual %}: {{ entry.original_title }}{% endunless %}—{{ entry.author }}'
  json_ld: '{{ entry.scx_json_ld }}'
  og_tags: '{{ entry.scx_og_tags }}'
  scripts:
    - 'userPrefs.js'
    - 'viewSettings.js'
    - 'listen.js'
---
<header>
  {% capture breadcrumbsList %}
    {% for crumb in entry.scx_breadcrumb_trail %}
      <li>
        {% comment %}
          Every ancestor is a search filter (`in`), by uid, so filtering on ie `dn` or `sutta` both find dn1.
          Not the text itself, unless it's a branch too, ie the pātimokkhas.
          The text's own uid stays in the index next to its name, so searching ie "mn1" still finds it first
        {% endcomment %}
        {% if forloop.last %}
          {% capture label -%}
            {{ crumb.name }}
            {%- if crumb.name != crumb.uid %}<span class="sr-only"> {{ crumb.uid }}</span>{% endif %}
          {%- endcapture %}
          {% if entry.node_type != 'leaf' %}
            <a href="{{ crumb.href }}" data-uid="{{ crumb.uid }}" data-pagefind-body data-pagefind-weight="10" data-pagefind-filter="in[data-uid]">{{ label }}</a>
          {% else %}
            <a href="{{ crumb.href }}" data-uid="{{ crumb.uid }}" data-pagefind-body data-pagefind-weight="10">{{ label }}</a>
          {% endif %}
        {% elsif crumb.href %}
          <a href="{{ crumb.href }}" data-uid="{{ crumb.uid }}" data-pagefind-filter="in[data-uid]">{{ crumb.name }}</a>
        {% else %}
          <span data-uid="{{ crumb.uid }}" data-pagefind-filter="in[data-uid]">{{ crumb.name }}</span>
        {% endif %}
      </li>
    {% endfor %}
    <li>
      <span aria-current="page">{{ entry.author | default: entry.author_uid | strip }}</span>
    </li>
  {% endcapture %}
  {% include "headerNav.liquid", breadcrumbsList: breadcrumbsList %}
</header>

<aside>
  <fieldset>
    <ul>
      {% if entry.scx_toc.size > 0 %}
        <li>
          <button
            popovertarget="contents-menu"
            tabindex="0"
            aria-controls="contents-menu"
            aria-label="Table of contents"
            title="Table of contents"
            id="contents-button"
          >
            {% icon "numberedListMicro" %}
          </button>
          <ol
            class="dropdown"
            popover
            aria-labelledby="contents-button"
            id="contents-menu"
            {% if entry.scx_toc_number_width != blank %}
              style="--toc-number-width: {{ entry.scx_toc_number_width }}"
            {% endif %}
          >
            {% for heading in entry.scx_toc %}
              <li
                data-level="{{ heading.level }}"
                {% if heading.isTitle %}
                  data-title
                {% endif %}
              >
                <a href="{{ heading.href }}">
                  {{- heading.html -}}
                </a>
              </li>
            {% endfor %}
          </ol>
        </li>
      {% endif %}
      <li>
        <button
          popovertarget="info"
          tabindex="0"
          aria-controls="info"
          aria-label="Show publication information"
          title="Show publication information"
          id="info-button"
        >
          {% icon "informationCircleMicro" %}
        </button>
      </li>
      <li>
        <button
          popovertarget="views-menu"
          tabindex="0"
          aria-controls="views-menu"
          aria-label="Text display settings"
          title="Text display settings"
          id="views-button"
        >
          {% icon "eyeMicro" %}
        </button>
        <ul
          class="dropdown"
          popover
          aria-labelledby="views-button"
          id="views-menu"
        >
          {% if entry.has_comment
            or entry._bilarasuttas_data.variant_text.size > 0
          %}
            <li>
              <label for="commenter">
                <span class="with-icon">
                  {% icon "chatBubbleBottomCenterTextMicro" -%}
                  <span>
                    {%- if entry.is_root %}Variants{% else %}Notes{% endif -%}
                  </span>
                </span>
                <kbd aria-hidden="true" title="Press N to cycle through these"
                  >N</kbd
                >
              </label>
              <input
                type="checkbox"
                id="commenter"
                checked
                aria-controls="commenter-inline"
              >
            </li>
            <li class="sub">
              <label for="commenter-inline">
                <span class="with-icon">
                  {% icon "bars3BottomLeftMicro" -%}
                  <span>Inline</span>
                </span>
              </label>
              <input
                type="checkbox"
                id="commenter-inline"
                aria-controls="commenter-side"
              >
            </li>
            <li class="sub sub-sub">
              <label for="commenter-side">
                <span class="with-icon">
                  {% icon "bars3BottomRightMicro" -%}
                  <span>Sidenotes</span>
                </span>
              </label>
              <input type="checkbox" id="commenter-side">
            </li>
          {% endif %}
          {% unless entry.is_root or entry.segmented == blank %}
            <li>
              <label for="rooter">
                <span class="with-icon">
                  {% icon "languageMicro" -%}
                  <span>Root text</span>
                </span>
                <kbd aria-hidden="true" title="Press V to cycle through these"
                  >V</kbd
                >
              </label>
              <input
                type="checkbox"
                id="rooter"
                aria-controls="rooter-side rooter-first"
              >
            </li>
            <li class="sub">
              <label for="rooter-side">
                <span class="with-icon">
                  {% icon "viewColumnsMicro" -%}
                  <span>Side by side</span>
                </span>
              </label>
              <input type="checkbox" id="rooter-side">
            </li>
            <li class="sub">
              <label for="rooter-first">
                <span class="with-icon">
                  {% icon "arrowsUpDownMicro" -%}
                  <span>Root first</span>
                </span>
                <kbd aria-hidden="true" title="Press F to toggle">F</kbd>
              </label>
              <input type="checkbox" id="rooter-first">
            </li>
          {% endunless %}
          {% if entry.scx_has_highlights %}
            <li>
              <label for="highlighter" title="Highlight text-critical details">
                <span class="with-icon">
                  {% icon "paintBrushMicro" -%}
                  <span>Highlighting</span>
                </span>
                <kbd aria-hidden="true" title="Press O to toggle">O</kbd>
              </label>
              <input
                type="checkbox"
                id="highlighter"
                title="Highlight text-critical details"
              >
            </li>
          {% endif %}
          {% if entry.segmented
            or entry._suttas_data.translation.text contains "class='ref"
          %}
            <li>
              <label for="segmenter">
                <span class="with-icon">
                  {% icon "hashtagMicro" -%}
                  <span>References</span>
                </span>
                <kbd aria-hidden="true" title="Press R to toggle">R</kbd>
              </label>
              <input
                type="checkbox"
                id="segmenter"
                {% if entry.scx_reference_groups.size > 1 %}
                  aria-controls="{% for group in entry.scx_reference_groups %}segmenter-{{ group }}{% unless forloop.last %} {% endunless %}{% endfor %}"
                {% endif %}
              >
            </li>
            {% comment %} With only one group the References checkbox says it all {% endcomment %}
            {% if entry.scx_reference_groups.size > 1 %}
              {% if entry.scx_reference_groups contains "main" %}
                <li class="sub">
                  <label for="segmenter-main" title="SuttaCentral">
                    <span class="with-icon">
                      {% icon "bookmarkMicro" -%}
                      <span>Main</span>
                    </span>
                    <kbd aria-hidden="true" title="Press M to toggle">M</kbd>
                  </label>
                  <input
                    type="checkbox"
                    id="segmenter-main"
                    title="SuttaCentral"
                    checked
                  >
                </li>
              {% endif %}
              {% if entry.scx_reference_groups contains "pts" %}
                <li class="sub">
                  <label
                    for="segmenter-pts"
                    title="{{ 'pts' | referenceEdition }}"
                  >
                    <span class="with-icon">
                      {% icon "documentMicro" -%}
                      <span>PTS</span>
                    </span>
                    <kbd aria-hidden="true" title="Press T to toggle">T</kbd>
                  </label>
                  <input
                    type="checkbox"
                    id="segmenter-pts"
                    title="{{ 'pts' | referenceEdition }}"
                  >
                </li>
              {% endif %}
              {% if entry.scx_reference_groups contains "others" %}
                <li class="sub">
                  <label
                    for="segmenter-others"
                    title="{{ entry.scx_other_editions }}"
                  >
                    <span class="with-icon">
                      {% icon "rectangleStackMicro" -%}
                      <span>Others</span>
                    </span>
                  </label>
                  <input
                    type="checkbox"
                    id="segmenter-others"
                    title="{{ entry.scx_other_editions }}"
                  >
                </li>
              {% endif %}
            {% endif %}
          {% endif %}
          <li>
            <label for="positioner">
              <span class="with-icon">
                {% icon "mapPinMicro" -%}
                <span>Pin menu</span>
              </span>
              <kbd aria-hidden="true" title="Press S to toggle">S</kbd>
            </label>
            <input type="checkbox" id="positioner" checked>
          </li>
        </ul>
      </li>
      <li>
        <button
          popovertarget="parallels"
          tabindex="0"
          aria-controls="parallels"
          aria-label="Show parallel texts"
          title="Show parallel texts"
          id="parallels-button"
        >
          {% icon "arrowsRightLeftMicro" %}
        </button>
      </li>
      <li>
        <button
          popovertarget="listen-menu"
          tabindex="0"
          aria-controls="listen-menu"
          aria-label="Text to speech settings"
          title="Text to speech settings"
          id="listen-menu-button"
        >
          {% icon "speakerWaveMicro" %}
        </button>
        <ul
          class="dropdown"
          popover
          aria-labelledby="listen-menu-button"
          id="listen-menu"
          data-text-lang="{{ entry.lang }}"
        >
          <li class="notice">
            <noscript>
              Please enable javascript to listen to this text. It reads aloud in
              your browser with your device's own voices, via the
              SpeechSynthesis API, and most of them work offline.
            </noscript>
          </li>
          <li id="no-voices" class="notice" hidden>
            No voices found. Listen reads aloud with the text-to-speech voices
            installed on your device - add a voice in your system's speech
            settings, then reload the page.
          </li>
          <li class="tts-controls">
            <button id="prev" type="button" disabled>
              <span>{% icon "backward" %}</span
              ><span
                ><span>Prev</span
                ><kbd aria-hidden="true" title="Press H">H</kbd></span
              >
            </button>
            <button id="playpause" type="button">
              <span>{% icon "play" %}</span
              ><span
                ><span>Play</span
                ><kbd aria-hidden="true" title="Press J">J</kbd></span
              >
            </button>
            <template id="pause-icon">{% icon "pause" %}</template>
            <button id="stop" type="button" disabled>
              <span>{% icon "stop" %}</span
              ><span
                ><span>Stop</span
                ><kbd aria-hidden="true" title="Press K">K</kbd></span
              >
            </button>
            <button id="next" type="button" disabled>
              <span>{% icon "forward" %}</span
              ><span
                ><span>Next</span
                ><kbd aria-hidden="true" title="Press L">L</kbd></span
              >
            </button>
          </li>
          <li>
            <label for="voice-select" class="with-icon">
              {% icon "microphoneMicro" -%}
              <span data-also-a="Rate" data-also-b="Pitch">Voice</span>
            </label>
            <select id="voice-select"></select>
            <button
              id="voice-info-button"
              type="button"
              aria-expanded="false"
              aria-controls="voice-info"
              aria-label="About voices"
              title="About voices"
            >
              {% icon "informationCircleMicro" %}
            </button>
          </li>
          <li id="voice-info" class="voice-info" hidden>
            <p>
              These voices all come from your device and browser. Higher quality
              voices are usually a free download in your system's speech or
              accessibility settings. Remember to reload the page after adding
              new ones.
            </p>
            {% comment %} Unhidden by the script for an online voice {% endcomment %}
            <p id="voice-info-online" hidden>
              Voices marked ONLINE send the text to the company that makes them,
              such as Google or Microsoft. The rest read it on your device.
            </p>
          </li>
          <li>
            <label for="rate" class="with-icon">
              {% icon "clockMicro" -%}
              <span data-also-a="Voice" data-also-b="Pitch">Rate</span>
            </label>
            <input
              type="range"
              min="0.5"
              max="2"
              value="1"
              step="0.1"
              id="rate"
            >
            <div id="rate-value">1.0</div>
          </li>
          <li>
            <label for="pitch" class="with-icon">
              {% icon "musicalNoteMicro" -%}
              <span data-also-a="Voice" data-also-b="Rate">Pitch</span>
            </label>
            <input
              type="range"
              min="0"
              max="2"
              value="1"
              step="0.1"
              id="pitch"
            >
            <div id="pitch-value">1.0</div>
          </li>
          <li>
            <label for="auto-scroll">
              <span class="with-icon">
                {% icon "chevronDoubleDownMicro" -%}
                <span>Auto-scroll</span>
              </span>
              <kbd aria-hidden="true" title="Press A to toggle">A</kbd>
            </label>
            <input type="checkbox" id="auto-scroll">
          </li>
        </ul>
      </li>
      <li class="aside-search">
        <button
          popovertarget="search-modal"
          aria-label="Search texts"
          title="Cmd/Ctrl+K"
        >
          {% icon "magnifyingGlassMicro" %}
        </button>
      </li>
    </ul>
  </fieldset>
</aside>

<main
  data-pagefind-body
  data-acronym="{{ entry.acronym }}"
  data-author="{{ entry.author }}"
  data-authoruid="{{ entry.author_uid }}"
  data-lang="{{ entry.lang }}"
  data-title="{{ entry.translated_title | default: entry.translated_name }}"
  data-translatorstitle="{{ entry._suttas_data.translation.title | default: '' }}"
  data-originaltitle="{{ entry.original_title }}"
  data-pagefind-meta="acronym[data-acronym], author[data-author], lang[data-lang], title[data-title], translatorsTitle[data-translatorstitle], originalTitle[data-originaltitle]"
  data-pagefind-filter="author[data-authoruid], lang[data-lang]"
>
  {% if entry.is_root and entry._bilarasuttas_data.size > 0 %}
    {% assign comments = "" %}
    {% for key in entry._bilarasuttas_data.keys_order %}
      {% comment %}
        First, decide whether or not to "process" a key for range-suttas
        every other text should always process all keys and skips this intro
      {% endcomment %}
      {% assign should_process = true %}
      {% assign is_header = false %}
      {% assign is_last_key = false %}

      {% comment %}
        A uid in no document at all gets the whole response, unfiltered
      {% endcomment %}
      {% if entry.scx_range_sutta_individual
        and entry.scx_range_sutta_shown_uid
      %}
        {% comment %}
          Check if this key is a :0.X header key, as this is where the headings are.
          These are useful for all texts in the range as including this heading gives context to the text
        {% endcomment %}
        {% assign key_segment = key | split: ":" | last %}
        {% if key_segment contains "0." %}
          {% assign header_html = entry._bilarasuttas_data.html_text[key] %}

          {% if header_html contains "<article id=" %}
            {% comment %}
              Article-specific header (e.g., "<article id='dhp1'>" or "<article id='an1.258-267'>")
              Extract the id and check if it matches this `entry.uid` or `entry.scx_range_sutta_uid`
            {% endcomment %}
            {% assign article_id_parts = header_html | split: "id='" %}
            {% assign article_id = article_id_parts[1] | split: "'" | first %}

            {% if article_id == entry.scx_range_sutta_uid
              or article_id == entry.uid
              or article_id == entry.scx_range_sutta_shown_uid
            %}
              {% assign is_header = true %}
            {% endif %}
          {% else %}
            {% comment %}
              Global range header (e.g., division, subdivision, range-title)
              These apply to all suttas in the range
            {% endcomment %}
            {% assign is_header = true %}
          {% endif %}
        {% endif %}

        {% comment %}
          Check if this is the last key
          (ie for the closing </article> and </section> tags)
        {% endcomment %}
        {% assign last_index = entry._bilarasuttas_data.keys_order.size
          | minus: 1
        %}
        {% assign is_last_key = false %}
        {% if forloop.index0 == last_index %}
          {% assign is_last_key = true %}
        {% endif %}

        {% comment %}
          Check if key belongs to the bilara document holding the text uid: its own,
          or the (sub-)range it's part of, ie /sn45.52 is in sn45.50-54, /an1.180 in an1.175-186
        {% endcomment %}
        {% assign key_id = key | split: ":" | first | downcase %}
        {% assign matches_uid = false %}
        {% if key_id == entry.scx_range_sutta_shown_uid %}
          {% assign matches_uid = true %}
        {% endif %}

        {% comment %} Include if it's a header, last key, or matches uid {% endcomment %}
        {% if is_header or is_last_key or matches_uid %}
          {% assign should_process = true %}
        {% else %}
          {% assign should_process = false %}
        {% endif %}
      {% endif %}

      {% if should_process %}
        {% assign html = entry._bilarasuttas_data.html_text[key] %}
        {% comment %} Handle individual range suttas some more... {% endcomment %}
        {% if entry.scx_range_sutta_individual and is_last_key %}
          {% assign last_key_prefix = key | split: ":" | first %}
          {% unless last_key_prefix == entry.scx_range_sutta_shown_uid %}
            {% comment %} These .end* <p> tag's are only needed on the last sutta in vagga/book {% endcomment %}
            {% assign html = html | replace: "<p class='endvagga'>{}</p>", "" %}
            {% assign html = html | replace: "<p class='end'>{}</p>", "" %}
            {% assign html = html | replace: "<p class='endbook'>{}</p>", "" %}
            {% comment %}
              Stricter check to handle other cases...
              ie an11.22/en/sujato to an11.29/en/sujato (/pli/ms also)
            {% endcomment %}
            {% comment %} But first exclude ie range an11.30/en/sujato to an11.69 where the last value is "{}</p></article>" {% endcomment %}
            {% assign html_first_two_chars = html | slice: 0, 2 %}
            {% if html contains "</article>" and html_first_two_chars != "{}" %}
              {% unless html contains entry.scx_range_sutta_shown_uid %}
                {% comment %} Remove everything except the closing tag(s) {% endcomment %}
                {% assign html = html
                  | split: "</article>"
                  | last
                  | prepend: "</article>"
                %}
              {% endunless %}
            {% endif %}
          {% endunless %}
        {% endif %}
        {% assign text = entry._bilarasuttas_data.root_text[key] %}
        {% assign comment = entry._bilarasuttas_data.variant_text[key] %}
        {% assign ref = key | split: ":" | last %}

        {% if html %}
          {% assign is_heading = html | isHeading %}
          {% capture replacement %}
          <span id="{{ key }}" class="segment">
            <span class="reference" id="{{ ref }}">
              <a href="#{{ ref }}" title="SuttaCentral segment number">{{ ref }}</a>
              {%- comment -%}
                Every printed-edition reference too, hidden like the number, so a link like /mn2/en/sujato#bj10.20 has
                somewhere to land - CSS reveals whichever is targeted. Not searchable, they'd only add noise like "pts" and "pli1"
              {%- endcomment -%}
              {%- assign ref_ids = entry._bilarasuttas_data.reference_text[key] | split: "," -%}
              {%- for ref_id in ref_ids -%}
                {%- assign id = ref_id | strip -%}
                {%- if id != blank -%}
                  <a class="ref {{ id | referenceGroup }}" id="{{ id }}" href="#{{ id }}" title="{{ id | referenceEdition }}" data-pagefind-ignore>{{ id }}</a>
                {%- endif -%}
              {%- endfor %}
            </span>
            {% if text %}
            <!-- This is not a translation, its the root text, the class is so it's not `display: none` by default. -->
            <span class="translation" lang="{{ entry.lang }}" translate="no">
              {% if entry.scx_range_sutta_individual
                and is_header
                and entry.scx_range_sutta_shown_uid == entry.uid
              %}
                {% comment %} Handle untitled root texts, eg range an11.22/pli/ms to 11.29 (and 30-69) has ~ as the title {% endcomment %}
                {% if text contains '~' %}
                  {% if html contains "class='range-title'" or html contains "class='sutta-title'" %}
                    {% capture text %}{{ entry.scx_range_sutta_title }}{% endcapture %}
                  {% endif %}
                {% endif %}
              {% endif %}
              <span class="text">{% if is_heading %}{{ text | softHyphenateTitle }}{% else %}{{ text }}{% endif %}</span>
              {% unless comment == blank %}
                <button class="variant-btn" popovertarget="comment-{{ key }}" aria-label="Show variant reading for segment {{ ref }}">*</button>
                <span class="inline-comment" aria-label="Variant reading for segment {{ ref }}">
                  Variant: {{ comment | replace: 'https://suttacentral.net', '' }}
                </span>
              {% endunless %}
            </span>
            {% endif %}
          </span>
          {% endcapture %}
          {{ html | replace: "{}", replacement }}
          {%- if comment -%}
            {% capture comments %}
            {{ comments }}
            <article id="comment-{{ key }}" popover>
              Variant: {{ comment | replace: 'https://suttacentral.net', '' }}
            </article>
            {% endcapture %}
          {%- endif -%}
        {% endif %}
      {% endif %}
    {% endfor %}
    {{ comments }}
    <article id="info" popover>
      {% include "publicationInfo.liquid", entry: entry %}
    </article>
  {% elsif entry.segmented %}
    {% assign comments = "" %}
    {% for key in entry._bilarasuttas_data.keys_order %}
      {% comment %}
        First, decide whether or not to "process" a key for range-suttas
        every other text should always process all keys and skips this intro
      {% endcomment %}
      {% assign should_process = true %}
      {% assign is_header = false %}
      {% assign is_last_key = false %}

      {% comment %}
        A uid in no document at all gets the whole response, unfiltered
      {% endcomment %}
      {% if entry.scx_range_sutta_individual
        and entry.scx_range_sutta_shown_uid
      %}
        {% comment %}
          Check if this key is a :0.X header key, as this is where the headings are.
          These are useful for all texts in the range as including this heading gives context to the text
        {% endcomment %}
        {% assign key_segment = key | split: ":" | last %}
        {% if key_segment contains "0." %}
          {% assign header_html = entry._bilarasuttas_data.html_text[key] %}

          {% if header_html contains "<article id=" %}
            {% comment %}
              Article-specific header (e.g., "<article id='dhp1'>" or "<article id='an1.258-267'>")
              Extract the id and check if it matches this `entry.uid` or `entry.scx_range_sutta_uid`
            {% endcomment %}
            {% assign article_id_parts = header_html | split: "id='" %}
            {% assign article_id = article_id_parts[1] | split: "'" | first %}

            {% if article_id == entry.scx_range_sutta_uid
              or article_id == entry.uid
              or article_id == entry.scx_range_sutta_shown_uid
            %}
              {% assign is_header = true %}
            {% endif %}
          {% else %}
            {% comment %}
              Global range header (e.g., division, subdivision, range-title)
              These apply to all suttas in the range
            {% endcomment %}
            {% assign is_header = true %}
          {% endif %}
        {% endif %}

        {% comment %}
          Check if this is the last key
          (ie for the closing </article> and </section> tags)
        {% endcomment %}
        {% assign last_index = entry._bilarasuttas_data.keys_order.size
          | minus: 1
        %}
        {% assign is_last_key = false %}
        {% if forloop.index0 == last_index %}
          {% assign is_last_key = true %}
        {% endif %}

        {% comment %}
          Check if key belongs to the bilara document holding the text uid: its own,
          or the (sub-)range it's part of, ie /sn45.52 is in sn45.50-54, /an1.180 in an1.175-186
        {% endcomment %}
        {% assign key_id = key | split: ":" | first | downcase %}
        {% assign matches_uid = false %}
        {% if key_id == entry.scx_range_sutta_shown_uid %}
          {% assign matches_uid = true %}
        {% endif %}

        {% comment %} Include if it's a header, last key, or matches uid {% endcomment %}
        {% if is_header or is_last_key or matches_uid %}
          {% assign should_process = true %}
        {% else %}
          {% assign should_process = false %}
        {% endif %}
      {% endif %}

      {% if should_process %}
        {% assign html = entry._bilarasuttas_data.html_text[key] %}
        {% comment %} Handle individual range suttas some more... {% endcomment %}
        {% if entry.scx_range_sutta_individual and is_last_key %}
          {% assign last_key_prefix = key | split: ":" | first %}
          {% unless last_key_prefix == entry.scx_range_sutta_shown_uid %}
            {% comment %} These .end* <p> tag's are only needed on the last sutta in vagga/book {% endcomment %}
            {% assign html = html | replace: "<p class='endvagga'>{}</p>", "" %}
            {% assign html = html | replace: "<p class='end'>{}</p>", "" %}
            {% assign html = html | replace: "<p class='endbook'>{}</p>", "" %}
            {% comment %}
              Stricter check to handle other cases...
              ie an11.22/en/sujato to an11.29/en/sujato (/pli/ms also)
            {% endcomment %}
            {% comment %} But first exclude ie range an11.30/en/sujato to an11.69 where the last value is "{}</p></article>" {% endcomment %}
            {% assign html_first_two_chars = html | slice: 0, 2 %}
            {% if html contains "</article>" and html_first_two_chars != "{}" %}
              {% unless html contains entry.scx_range_sutta_shown_uid %}
                {% comment %} Remove everything except the closing tag(s) {% endcomment %}
                {% assign html = html
                  | split: "</article>"
                  | last
                  | prepend: "</article>"
                %}
              {% endunless %}
            {% endif %}
          {% endunless %}
        {% endif %}
        {% assign text = entry._bilarasuttas_data.translation_text[key] %}
        {% assign rootText = entry._bilarasuttas_data.root_text[key] %}
        {% assign comment = entry._bilarasuttas_data.comment_text[key] %}
        {% assign variant = entry._bilarasuttas_data.variant_text[key] %}
        {% assign ref = key | split: ":" | last %}

        {% if html %}
          {% assign is_heading = html | isHeading %}
          {% capture replacement %}
          <span id="{{ key }}" class="segment">
            <span class="reference" id="{{ ref }}">
              <a href="#{{ ref }}" title="SuttaCentral segment number">{{ ref }}</a>
              {%- comment -%}
                Every printed-edition reference too, hidden like the number, so a link like /mn2/en/sujato#bj10.20 has
                somewhere to land - CSS reveals whichever is targeted. Not searchable, they'd only add noise like "pts" and "pli1"
              {%- endcomment -%}
              {%- assign ref_ids = entry._bilarasuttas_data.reference_text[key] | split: "," -%}
              {%- for ref_id in ref_ids -%}
                {%- assign id = ref_id | strip -%}
                {%- if id != blank -%}
                  <a class="ref {{ id | referenceGroup }}" id="{{ id }}" href="#{{ id }}" title="{{ id | referenceEdition }}" data-pagefind-ignore>{{ id }}</a>
                {%- endif -%}
              {%- endfor %}
            </span>
            {% if text %}
              <span class="translation" lang="{{ entry.lang }}"{% if text == entry.translated_title or text == entry.translated_name %} data-pagefind-weight="8"{% endif %}>
            {% comment %}
              Swap the vagga heading for the number, but only when the sutta has no translated
              heading of its own to title the page (ie Dhp verses) - otherwise it'd just repeat it
            {% endcomment %}
            {% if entry.scx_range_sutta_individual
              and is_header
              and entry.scx_range_sutta_shown_uid == entry.uid
              and entry.scx_range_sutta_untitled
            %}
              {% if text == entry.translated_title or text == entry.translated_name %}
                {% capture text %}{{ entry.scx_range_sutta_title }}{% endcapture %}
              {% endif %}
            {% endif %}
            <span class="text">{{ text }}</span>
              {% unless comment == blank %}
                <button popovertarget="comment-{{ key }}" aria-label="Show {{ entry.author }}'s footnote for segment {{ key }}">*</button>
                <span class="inline-comment" aria-label="{{ entry.author }}'s footnote for segment {{ key }}">
                  {{ comment | replace: 'https://suttacentral.net', '' }}
                </span>
              {% endunless %}
            </span>
            {% endif %}
            {% if rootText %}
              {% assign normalisedRoot = rootText | normalise %}
              {% assign normalisedTitle = entry.original_title | normalise %}
              <span class="root" lang="{{ entry.root_lang }}" translate="no" {% unless normalisedRoot contains normalisedTitle %}data-pagefind-ignore="all"{% endunless %}>
                {% if entry.scx_range_sutta_individual
                  and is_header
                  and entry.scx_range_sutta_shown_uid == entry.uid
                %}
                  {% if text == entry.scx_range_sutta_title %}
                    {% capture rootText %}{{ entry.scx_range_sutta_title }}{% endcapture %}
                  {% endif %}
                {% endif %}
                <span class="text">{% if is_heading %}{{ rootText | softHyphenateTitle }}{% else %}{{ rootText }}{% endif %}</span>
                {% unless variant == blank %}
                  <button class="variant-btn" popovertarget="variant-{{ key }}" aria-label="Show variant reading for segment {{ ref }}">*</button>
                  <span class="inline-comment" aria-label="Variant reading for segment {{ ref }}">
                    Variant: {{ variant | replace: 'https://suttacentral.net', '' }}
                  </span>
                {% endunless %}
              </span>
            {% endif %}
          </span>
          {% endcapture %}
          {{ html | replace: "{}", replacement }}
          {%- if comment -%}
            {% capture comments %}
            {{ comments }}
            <article id="comment-{{ key }}" popover>
              {{ comment | replace: 'https://suttacentral.net', '' }}
            </article>
            {% endcapture %}
          {%- endif -%}
          {%- if variant -%}
            {% capture comments %}
            {{ comments }}
            <article id="variant-{{ key }}" popover>
              Variant: {{ variant | replace: 'https://suttacentral.net', '' }}
            </article>
            {% endcapture %}
          {%- endif -%}
        {% endif %}
      {% endif %}
    {% endfor %}
    {{ comments }}
    {% if entry._publication_info != blank %}
      <article id="info" popover>
        {% include "publicationInfo.liquid", entry: entry %}
      </article>
    {% endif %}
  {% else %}
    {% assign html_content = entry._suttas_data.translation.text
      | replace: "\n", ""
      | addReferenceGroups
    %}
    {% assign original_footer = html_content
      | split: "<footer"
      | last
      | split: "</footer>"
      | first
      | prepend: "<footer"
      | append: "</footer>"
    %}
    {% assign html_without_footer = html_content
      | replace: original_footer, ""
    %}
    {% assign modified_footer = original_footer
      | replace: "<footer", '<article id="info" popover'
      | replace: "</footer>", "</article>"
    %}
    {{ html_without_footer }}
    {{ modified_footer }}
  {% endif %}

  <article id="parallels" popover>
    {% assign left_title = entry.original_title | default: entry.root_name %}
    {% assign right_title = entry.translated_title
      | default: entry.translated_name
    %}
    {% if right_title != blank %}
      {% assign full_title = left_title | append: "—" | append: right_title %}
    {% else %}
      {% assign full_title = left_title %}
    {% endif %}
    {% include "textMetaContent.liquid",
      entry: entry,
      title: full_title,
      translations: entry._suttas_data.suttaplex.translations,
      parallelsOpen: true
    %}
  </article>
</main>

<nav aria-label="Article pagination">
  <div>
    {% unless entry._suttas_data.translation.previous.uid == blank
      and entry.scx_range_sutta_pagination.prev.uid == blank
    %}
      <span>Previous</span>
      <a
        href="/{{ entry.scx_range_sutta_pagination.prev.uid | default: entry._suttas_data.translation.previous.uid }}{% if entry._suttas_data.translation.previous.lang %}/{{ entry._suttas_data.translation.previous.lang }}/{{ entry._suttas_data.translation.previous.author_uid }}{% endif %}"
        rel="prev"
      >
        {{
          entry.scx_range_sutta_pagination.prev.name
          | default: entry._suttas_data.translation.previous.name
          | softHyphenateTitle
        }}
      </a>
    {% endunless %}
  </div>
  <div>
    {% unless entry._suttas_data.translation.next.uid == blank
      and entry.scx_range_sutta_pagination.next.uid == blank
    %}
      <span>Next</span>
      <a
        href="/{{ entry.scx_range_sutta_pagination.next.uid | default: entry._suttas_data.translation.next.uid }}{% if entry._suttas_data.translation.next.lang %}/{{ entry._suttas_data.translation.next.lang }}/{{ entry._suttas_data.translation.next.author_uid }}{% endif %}"
        rel="next"
      >
        {{
          entry.scx_range_sutta_pagination.next.name
          | default: entry._suttas_data.translation.next.name
          | softHyphenateTitle
        }}
      </a>
    {% endunless %}
  </div>
</nav>

{% include "footer.liquid",
  route: entry.scx_path,
  fetchedAt: entry.scx_fetched_at
%}

{% if _siteMetaData.environment == "dev" %}
  <script>
    const data = {{ entry | jsonify }};
    console.log(data);
  </script>
{% endif %}
