<nav aria-label="Breadcrumb">
  <ul>
    {% if isHome %}
      <li aria-current="page">
        <span>
          {%- icon "homeMicro" -%}
          <span class="sr-only">Home</span></span
        >
      </li>
    {% else %}
      <li>
        <a href="/" aria-label="Home">
          {%- icon "homeMicro" -%}
          <span class="sr-only">Home</span></a
        >
      </li>
      {{ breadcrumbsList }}
    {% endif %}
  </ul>
  {% unless excludeSearch %}
    <button
      type="submit"
      popovertarget="search-modal"
      aria-label="Search texts"
      title="Cmd/Ctrl+K"
    >
      {% icon "magnifyingGlassMicro" %}
    </button>
  {% endunless %}
</nav>
{% unless excludeSearch %}
  <section id="search-modal" popover>
    {% include "searchForm.liquid" %}
  </section>
{% endunless %}
